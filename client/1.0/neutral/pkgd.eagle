#
# NOTE: Use our own namespace here because even though we do not directly
#       support namespaces ourselves, we do not want to pollute the global
#       namespace if this script actually ends up being evaluated in Tcl.
#
namespace eval ::PackageDownloader {
  #
  # NOTE: This procedure emits a message to the package downloader client
  #       log.  The string argument is the content of the message to emit.
  #
  proc pkgLog { string } {
    # <help>
    # This procedure emits a single diagnostic message to the package
    # downloader client log.  It exists to give every other procedure in the
    # toolset a uniform, fire-and-forget way to record progress, warnings, and
    # errors without having to worry about formatting or about logging itself
    # failing.  It is used throughout the download, verify, and install paths
    # for tracing and troubleshooting.
    #
    # How it works: it builds a single log line by prefixing the caller's
    # message with the current process id, the current wall-clock time (in
    # seconds since the epoch), and a fixed "pkgd" tag, then hands that line to
    # [tclLog].  The entire operation is wrapped in [catch] so that a logging
    # failure (for example, a redefined or unavailable [tclLog]) can never
    # propagate an error back into the calling code.
    #
    # Tricky details: because the work is swallowed by [catch], a caller can
    # never tell whether the message was actually recorded; logging is treated
    # as strictly best-effort.  The timestamp is a raw epoch second count, not
    # a formatted date.
    #
    # Arguments:
    #   string -- The content of the message to emit.  It is logged verbatim
    #             after the standard prefix; it may be any string.
    #
    # Results:
    #   The result is unspecified and should be ignored; this procedure is
    #   invoked purely for its logging side effect.
    # </help>

    catch {
      tclLog [appendArgs [pid] " : " [clock seconds] " : pkgd : " $string]
    }
  }

  #
  # NOTE: This procedure sets up the default values for all URN configuration
  #       parameters used by the package downloader client.  If the force
  #       argument is non-zero, any existing values will be overwritten and
  #       set back to their default values.
  #
  proc setupDownloadServerVars { force } {
    # <help>
    # This procedure establishes the default values for all of the URN (Uniform
    # Resource Name) configuration parameters used by the package downloader
    # client.  These URNs name the server-side endpoints, relative to the base
    # URI, for downloading package signing keys (primary and fallback mirror),
    # logging in, querying supported platforms, downloading package files, and
    # logging out.  It exists so that the toolset has a known-good starting
    # configuration that an optional settings file or the [useServerId]
    # procedure can later override.
    #
    # How it works: for each configuration item it declares the corresponding
    # namespace variable and then, only if the force flag is true or the
    # variable does not yet exist, assigns it the documented default value.
    # This "set only if forced or missing" pattern is what allows previously
    # customized values (for example, from a settings file read earlier) to
    # survive a non-forced call.
    #
    # Tricky/security details: these URNs ultimately determine which server
    # endpoints the client contacts for keys, login, and package data.  The
    # prefixes assigned here (for example, the package-keys and download URNs)
    # are duplicated, by necessity, in [useServerId]; the two MUST be kept
    # synchronized or alternate-server selection will target the wrong
    # endpoints.  This procedure does not itself contact the network or
    # validate the URNs.
    #
    # Arguments:
    #   force -- A boolean.  When true, every URN variable is reset to its
    #            built-in default, discarding any prior value.  When false,
    #            only variables that do not already exist are initialized,
    #            preserving existing customizations.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   of populating the namespace URN configuration variables.
    # </help>

    #
    # NOTE: The URN, relative to the base URI, where the Package Signing Keys
    #       may be downloaded.
    #
    variable openPgpKeyUrn; # DEFAULT: pkg_keys

    if {$force || ![info exists openPgpKeyUrn]} then {
      set openPgpKeyUrn pkg_keys
    }

    #
    # NOTE: The fallback URN, relative to the base URI, where the Package
    #       Signing Keys may be downloaded.  This should only be used when
    #       the primary URN did not produce valid data.
    #
    variable openPgpKeyUrnFallback1; # DEFAULT: pkg_keys_mirror_1

    if {$force || ![info exists openPgpKeyUrnFallback1]} then {
      set openPgpKeyUrnFallback1 pkg_keys_mirror_1
    }

    #
    # NOTE: The URN, relative to the base URI, where a login request may
    #       be sent.
    #
    variable loginUrn; # DEFAULT: pkgd_login

    if {$force || ![info exists loginUrn]} then {
      set loginUrn pkgd_login
    }

    #
    # NOTE: The URN, relative to the base URI, where the list of supported
    #       platforms for a single package may be found.
    #
    variable platformsUrn; # DEFAULT: pkgd_platforms

    if {$force || ![info exists platformsUrn]} then {
      set platformsUrn pkgd_platforms
    }

    #
    # NOTE: The URN, relative to the base URI, where a single package file
    #       may be found.
    #
    variable downloadUrn; # DEFAULT: pkgd_file

    if {$force || ![info exists downloadUrn]} then {
      set downloadUrn pkgd_file
    }

    #
    # NOTE: The URN, relative to the base URI, where a logout request may
    #       be sent.
    #
    variable logoutUrn; # DEFAULT: pkgd_logout

    if {$force || ![info exists logoutUrn]} then {
      set logoutUrn pkgd_logout
    }
  }

  #
  # NOTE: This procedure sets up the default values for all version
  #       configuration parameters used by the package downloader client.
  #       If the force argument is non-zero, any existing values will be
  #       overwritten and set back to their default values.
  #
  proc setupDownloadVersionVars { force } {
    # <help>
    # This procedure establishes the default values for the version-related
    # configuration parameters used by the package downloader client.  At
    # present this is just the source branch name (defaulting to "trunk") from
    # which package files are fetched.  It exists so that the version/branch
    # selection has a known default that the [useVersionId] procedure or a
    # settings file can later override.
    #
    # How it works: it declares the branch-name namespace variable and assigns
    # it the default value only when the force flag is true or the variable
    # does not already exist, leaving any prior customization intact otherwise.
    #
    # Tricky details: the branch name effectively chooses which revision of the
    # package files is downloaded; changing it changes what content the client
    # retrieves.
    #
    # Arguments:
    #   force -- A boolean.  When true, the branch-name variable is reset to its
    #            built-in default.  When false, it is initialized only if it
    #            does not already exist.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   of populating the version configuration variable.
    # </help>

    #
    # NOTE: The name of the branch where the package files should be fetched
    #       from.
    #
    variable branchName; # DEFAULT: trunk

    if {$force || ![info exists branchName]} then {
      set branchName trunk
    }
  }

  #
  # NOTE: This procedure sets up the default values for all URI configuration
  #       parameters used by the package downloader client.  If the force
  #       argument is non-zero, any existing values will be overwritten and
  #       set back to their default values.
  #
  proc setupDownloadUriVars { force } {
    # <help>
    # This procedure establishes the default values for all of the URI
    # configuration parameters used by the package downloader client.  This
    # includes the base URI of the package file server (defaulting to an
    # HTTPS endpoint) and the templated URIs for downloading signing keys (and
    # a fallback mirror), logging in, querying platforms, downloading package
    # files, and logging out.  It exists to define, in one place, exactly how
    # each request URI is composed from the base URI, the configured URNs, and
    # the relevant runtime values.
    #
    # How it works: for each URI item it declares the corresponding namespace
    # variable and assigns it the default only when force is true or the
    # variable is missing.  Importantly, most of the assigned values are NOT
    # final URIs; they are brace-quoted template strings containing references
    # such as the base-URI variable, a URN variable, and bracketed calls to
    # [uriEscape].  These templates are deliberately stored unevaluated so that
    # a later [subst] (performed by the consuming procedure, in a context where
    # the referenced variables like user name, password, file name, or auth
    # token are visible) expands them into the actual request URI.
    #
    # Tricky/security details: because the templates are expanded later via
    # [subst], any value interpolated into them (login credentials, file names,
    # auth tokens) is the thing that ends up in the request.  The login and
    # logout templates pass their values through [uriEscape] for query-string
    # safety; callers that bypass this and build URIs by other means lose that
    # protection.  The default base URI is HTTPS, which is relied upon for
    # transport confidentiality of credentials and cookies.  This procedure
    # does not perform any network access or validation.
    #
    # Arguments:
    #   force -- A boolean.  When true, every URI variable is reset to its
    #            built-in default template.  When false, only variables that do
    #            not already exist are initialized, preserving customizations.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   of populating the namespace URI configuration variables.
    # </help>

    #
    # NOTE: The base URI used to build the URIs for the package file server.
    #
    variable baseUri; # DEFAULT: https://tcl.to/r

    if {$force || ![info exists baseUri]} then {
      set baseUri https://tcl.to/r
    }

    #
    # NOTE: The URI where the Package Signing Keys may be downloaded.  This
    #       should return a payload containing the OpenPGP key data.
    #
    variable openPgpKeyUri; # DEFAULT: ${baseUri}/${openPgpKeyUrn}

    if {$force || ![info exists openPgpKeyUri]} then {
      set openPgpKeyUri {${baseUri}/${openPgpKeyUrn}}
    }

    #
    # NOTE: The fallback URI where the Package Signing Keys may be
    #       downloaded.  This should return a payload containing the OpenPGP
    #       key data.  This should only be used when the primary URN did not
    #       produce valid OpenPGP key data.
    #
    variable openPgpKeyUriFallback; # DEFAULT: .../${openPgpKeyUrnFallback1}

    if {$force || ![info exists openPgpKeyUriFallback]} then {
      set openPgpKeyUriFallback {${baseUri}/${openPgpKeyUrnFallback1}}
    }

    #
    # NOTE: The URI where a login request may be sent.  This should return a
    #       payload containing the necessary HTTP(S) cookie information.
    #
    variable loginUri; # DEFAULT: ${baseUri}/${loginUrn}?...

    if {$force || ![info exists loginUri]} then {
      set loginUri [appendArgs \
          {${baseUri}/${loginUrn}?} {[uriEscape name $userName]} & \
          {[uriEscape password $password]}]
    }

    #
    # NOTE: The URI where the list of supported platforms for a single
    #       package may be found.
    #
    variable platformsUri; # DEFAULT: ${baseUri}/${platformsUrn}?...

    if {$force || ![info exists platformsUri]} then {
      set platformsUri {${baseUri}/${platformsUrn}?download&name=${branchName}}
    }

    #
    # NOTE: The URI where a single package file may be found.  This file will
    #       belong to a specific version of one package.
    #
    variable downloadUri; # DEFAULT: ${baseUri}/${downloadUrn}?...

    if {$force || ![info exists downloadUri]} then {
      set downloadUri [appendArgs \
          {${baseUri}/${downloadUrn}?download&ci=${branchName}&} \
          {[uriEscape filename $fileName]}]
    }

    #
    # NOTE: The URI where a logout request should be sent.  This should
    #       return a payload indicating that the logout was successful.
    #
    variable logoutUri; # DEFAULT: ${baseUri}/${logoutUrn}?...

    if {$force || ![info exists logoutUri]} then {
      set logoutUri [appendArgs \
          {${baseUri}/${logoutUrn}?} {[uriEscape authToken $authToken]}]
    }
  }

  #
  # NOTE: This procedure sets up the default values for all configuration
  #       parameters used by the package downloader client.  The script
  #       argument is the fully qualified path and file name for the script
  #       being evaluated.
  #
  proc setupDownloadVars { script force } {
    # <help>
    # This procedure establishes the default values for the broad set of
    # general configuration parameters used by the package downloader client
    # that are not specifically URNs, URIs, or version selectors.  Among other
    # things it records the client directory (derived from the path of the
    # evaluating script), the (initially empty) HTTP(S) login cookie, the quiet
    # and verbose-temporary-directory flags, the public-account user name and
    # password, the persistent and temporary root directories, the
    # via-installer flag, and the executable names, probe commands, and version
    # patterns used to detect Mono and .NET Core.  It exists as the central
    # one-time initializer that makes the toolset usable out of the box.
    #
    # How it works: for each item it declares the namespace variable and, only
    # when force is true or the variable does not already exist, assigns the
    # documented default.  Some defaults are computed (the client directory via
    # [file normalize] of the script's directory, the persistent root via
    # [getPersistentRootDirectory], the temporary root via the package
    # repository helper) and some are platform-dependent (the Mono and .NET
    # Core executable names differ on Windows).  As with the other setup
    # procedures, the "set only if forced or missing" pattern preserves values
    # supplied earlier by a settings file.
    #
    # Tricky/security details: the public-account password default is embedded
    # here in plaintext.  Per the in-line notes it is NOT treated as a true
    # secret, but it is still access-control material and should not be shared
    # with anyone lacking access to this client.  The Mono and .NET Core probe
    # commands are stored as brace-quoted templates and are later expanded with
    # [subst] and executed via [exec]; the configured executable names are
    # therefore eventually run as external processes, so any override of those
    # names is security-relevant.  The login cookie is initialized empty here,
    # meaning the client starts out unauthenticated.
    #
    # Arguments:
    #   script -- The fully qualified path and file name of the script being
    #             evaluated; its directory is used to derive the client
    #             directory.
    #   force  -- A boolean.  When true, every configuration variable is reset
    #             to its default.  When false, only missing variables are
    #             initialized, preserving existing values.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   of populating the namespace configuration variables.
    # </help>

    #
    # NOTE: What is the fully qualified path to the directory containing the
    #       package downloader client?
    #
    variable clientDirectory

    if {$force || ![info exists clientDirectory]} then {
      set clientDirectory [file normalize [file dirname $script]]
    }

    #
    # NOTE: This is the HTTP(S) login cookie to use when downloading files
    #       from the package file server.
    #
    variable loginCookie; # DEFAULT: NONE

    if {$force || ![info exists loginCookie]} then {
      set loginCookie [list]
    }

    #
    # NOTE: Prevent progress messages from being displayed while downloading
    #       from the repository, etc?  By default, this is enabled.
    #
    variable quiet; # DEFAULT: true

    if {$force || ![info exists quiet]} then {
      set quiet true
    }

    #
    # NOTE: Emit diagnostic messages when a new temporary directory name is
    #       created.
    #
    variable verboseTemporaryDirectory; # DEFAULT: false

    if {$force || ![info exists verboseTemporaryDirectory]} then {
      set verboseTemporaryDirectory false
    }

    #
    # NOTE: The user name for the public account on the package file server.
    #       If this is an empty string, there is no public account.
    #
    variable publicUserName; # DEFAULT: public

    if {$force || ![info exists publicUserName]} then {
      set publicUserName public
    }

    #
    # NOTE: The password associated with the public account on the package
    #       file server.  If this is an empty string, the public account is
    #       disabled.  This is not considered to be a secret; however, it
    #       should not be shared with any person or organization that does
    #       not have access to the package downloader client.
    #
    variable publicPassword; # DEFAULT: X+NlF2obS5tQFKIsf/q345/naqVSGD67Cg

    if {$force || ![info exists publicPassword]} then {
      set publicPassword X+NlF2obS5tQFKIsf/q345/naqVSGD67Cg
    }

    #
    # NOTE: The root directory where any persistent packages will be saved.
    #
    variable persistentRootDirectory; # DEFAULT: [getPersistentRootDirectory]

    if {$force || ![info exists persistentRootDirectory]} then {
      set persistentRootDirectory [getPersistentRootDirectory]
    }

    #
    # NOTE: The root directory where any temporary packages will be written.
    #
    variable temporaryRootDirectory; # DEFAULT: [getFileTempDirectory PKGD_TEMP]

    if {$force || ![info exists temporaryRootDirectory]} then {
      set temporaryRootDirectory \
          [::PackageRepository::getFileTempDirectory PKGD_TEMP]
    }

    #
    # NOTE: Is this package being run by the package installer tool?  If so,
    #       all downloaded packages should be automatically persisted to the
    #       library path.
    #
    variable viaInstall; # DEFAULT: false

    if {$force || ![info exists viaInstall]} then {
      set viaInstall false
    }

    #
    # NOTE: This is the name of the executable file used to invoke the
    #       Mono implementation, possibly without a file extension.
    #
    variable monoFileNameOnly; # DEFAULT: <unset>

    if {$force || ![info exists monoFileNameOnly]} then {
      if {[isWindows]} then {
        set monoFileNameOnly mono.exe
      } else {
        set monoFileNameOnly mono
      }
    }

    #
    # NOTE: The command to use when attempting to verify that Mono and its
    #       associated runtimes are installed locally.  Generally, this is
    #       not needed on Windows machines.
    #
    variable monoInstalledCommand; # DEFAULT: mono --version

    if {$force || ![info exists monoInstalledCommand]} then {
      set monoInstalledCommand {{${monoFileNameOnly}} --version}
    }

    #
    # NOTE: The regular expression pattern used when attempting to verify
    #       that Mono and its associated runtimes are installed locally.
    #       Generally, this is not needed on Windows machines.
    #
    variable monoInstalledPattern; # DEFAULT: ^Mono JIT compiler version \d+\.

    if {$force || ![info exists monoInstalledPattern]} then {
      set monoInstalledPattern {^Mono JIT compiler version \d+\.}
    }

    #
    # NOTE: This is the name of the executable file used to invoke the
    #       .NET Core implementation, possibly without a file extension.
    #
    variable dotnetFileNameOnly; # DEFAULT: <unset>

    if {$force || ![info exists dotnetFileNameOnly]} then {
      if {[isWindows]} then {
        set dotnetFileNameOnly dotnet.exe
      } else {
        set dotnetFileNameOnly dotnet
      }
    }

    #
    # NOTE: The command to use when attempting to verify that .NET Core and
    #       its associated runtimes are installed locally.  Generally, this
    #       is not needed on Windows machines.
    #
    variable dotnetInstalledCommand; # DEFAULT: dotnet --version

    if {$force || ![info exists dotnetInstalledCommand]} then {
      set dotnetInstalledCommand {{${dotnetFileNameOnly}} --version}
    }

    #
    # NOTE: The regular expression pattern used when attempting to verify
    #       that .NET Core and its associated runtimes are installed locally.
    #       Generally, this is not needed on Windows machines.
    #
    variable dotnetInstalledPattern; # DEFAULT: ^\d+\.\d+(?:\.\d+)*$

    if {$force || ![info exists dotnetInstalledPattern]} then {
      set dotnetInstalledPattern {^\d+\.\d+(?:\.\d+)*$}
    }
  }

  #
  # NOTE: This procedure modifies the URN variables used by the package
  #       downloader client so that one or more alternative (private?)
  #       backend file servers may be used.  The serverId argument must
  #       consist only of alphanumeric characters and it must begin with
  #       a letter.
  #
  # <public>
  proc useServerId { {serverId ""} } {
    # <help>
    # This procedure reconfigures the URN variables used by the package
    # downloader client so that an alternate (often private) backend file
    # server can be targeted instead of the default one.  It exists to let a
    # single client installation be pointed at a differently provisioned server
    # without editing the script, by appending a caller-supplied server
    # identifier to each well-known URN prefix.
    #
    # How it works: it first validates the server identifier through the
    # package repository helper.  If the identifier is a non-empty string, it
    # rebuilds the download, login, logout, signing-key (primary and fallback
    # mirror), and platforms URNs by appending the identifier to hard-coded
    # prefixes.  If the identifier is the empty string, it instead forcibly
    # restores all URNs to their built-in defaults by calling
    # [setupDownloadServerVars] with force enabled.
    #
    # Tricky/security details: the URN prefixes used here are hard-coded and,
    # per the in-line HACK note, MUST be kept manually synchronized with the
    # defaults in [setupDownloadServerVars]; if they drift, this procedure will
    # silently build URNs that point at the wrong (or nonexistent) endpoints.
    # The server identifier is constrained by the repository helper to be
    # alphanumeric and to begin with a letter, which both validates input and
    # guards against injection of unexpected characters into endpoint names.
    # Selecting a server changes which host the client trusts for keys, login,
    # and package data, so it is a security-relevant configuration change.
    #
    # Arguments:
    #   serverId -- Optional.  An alphanumeric identifier beginning with a
    #               letter that selects an alternate backend server.  Defaults
    #               to the empty string, which restores the default URNs.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   of updating the URN configuration variables.  An invalid server
    #   identifier raises a script error.
    # </help>

    variable downloadUrn
    variable loginUrn
    variable logoutUrn
    variable openPgpKeyUrn
    variable openPgpKeyUrnFallback1
    variable platformsUrn

    ::PackageRepository::verifyServerId $serverId

    if {[string length $serverId] > 0} then {
      #
      # NOTE: Reset the URN variables to values that should cause
      #       the specified server Id to be used (assume the server
      #       Id itself is valid and active).
      #
      # HACK: These prefixes are hard-coded and must be manually kept
      #       synchronized with those in the setupDownloadServerVars
      #       procedure.
      #
      set downloadUrn [appendArgs pkgd_file_ $serverId]
      set loginUrn [appendArgs pkgd_login_ $serverId]
      set logoutUrn [appendArgs pkgd_logout_ $serverId]
      set openPgpKeyUrn [appendArgs pkg_keys_ $serverId]
      set openPgpKeyUrnFallback1 [appendArgs pkg_keys_mirror_1_ $serverId]
      set platformsUrn [appendArgs pkgd_platforms_ $serverId]
    } else {
      #
      # NOTE: Forcibly reset URN variables to their default values.
      #
      setupDownloadServerVars true
    }
  }

  #
  # NOTE: This procedure modifies the version variables used by the package
  #       downloader client so that a specific version will be used.  The
  #       versionId argument must consist only of hexadecimal characters.
  #
  # <public>
  proc useVersionId { {versionId ""} } {
    # <help>
    # This procedure reconfigures the version variables used by the package
    # downloader client so that a specific repository version (a Fossil
    # check-in identifier) is fetched instead of the default branch.  It exists
    # to let callers pin downloads to an exact revision rather than tracking the
    # tip of a branch.
    #
    # How it works: it first validates the version identifier via
    # [verifyVersionId].  If the identifier is a non-empty string, it sets the
    # branch-name variable to that identifier so subsequent requests target it.
    # If the identifier is the empty string, it forcibly restores the version
    # variables to their defaults by calling [setupDownloadVersionVars] with
    # force enabled.
    #
    # Tricky/security details: the version identifier is constrained by
    # [verifyVersionId] to be hexadecimal, matching the form of a Fossil
    # check-in hash and preventing unexpected characters from being injected
    # into the branch/version field of request URIs.  Pinning to a specific
    # version is the safer choice when reproducibility matters, since a branch
    # name can move.
    #
    # Arguments:
    #   versionId -- Optional.  A hexadecimal version (check-in) identifier to
    #                pin downloads to.  Defaults to the empty string, which
    #                restores the default branch.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   of updating the version configuration variable.  An invalid version
    #   identifier raises a script error.
    # </help>

    variable branchName

    verifyVersionId $versionId

    if {[string length $versionId] > 0} then {
      #
      # NOTE: Set the variables to values that should cause the specified
      #       version Id to be used (assume the version Id itself is valid
      #       and active).
      #
      set branchName $versionId; # TODO: Translations here?
    } else {
      #
      # NOTE: Forcibly reset the variables to their default values.
      #
      setupDownloadVersionVars true
    }
  }

  #
  # NOTE: This procedure escapes a single name/value pair for use in a URI
  #       query string.  The name argument is the name of the parameter.
  #       The value argument is the value of the parameter.
  #
  proc uriEscape { name value } {
    # <help>
    # This procedure escapes a single name/value pair for safe inclusion in a
    # URI query string, returning the encoded "name=value" fragment.  It exists
    # so that user-supplied values (login names, passwords, file names, auth
    # tokens) can be embedded in request URIs without breaking the query-string
    # syntax or allowing query-parameter injection.
    #
    # How it works: under Eagle it uses the built-in [uri escape data] to
    # percent-encode the name and the value independently and joins them with
    # an equals sign.  Under native Tcl it loads the http package and delegates
    # to its formatQuery helper, which performs the equivalent encoding.  This
    # gives consistent behavior across both supported languages.
    #
    # Tricky/security details: this is the toolset's primary defense against
    # query-string injection; both the name and the value are encoded, so even
    # values containing ampersands, equals signs, or other reserved characters
    # are rendered inert.  It is relied upon by the URI templates built in
    # [setupDownloadUriVars].
    #
    # Arguments:
    #   name  -- The query parameter name to encode.
    #   value -- The query parameter value to encode.
    #
    # Results:
    #   A percent-encoded "name=value" string suitable for use as one element
    #   of a URI query string.
    # </help>

    if {[isEagle]} then {
      return [appendArgs \
          [uri escape data $name] = [uri escape data $value]]
    } else {
      package require http 2.0

      return [::http::formatQuery $name $value]
    }
  }

  #
  # NOTE: This procedure returns the root directory where any packages that
  #       are downloaded should be saved to permanent storage for subsequent
  #       use.  There are no arguments.
  #
  proc getPersistentRootDirectory {} {
    # <help>
    # This procedure returns the root directory under which downloaded packages
    # should be saved to permanent storage for subsequent reuse.  It exists to
    # centralize the policy for where persistent packages live so that the rest
    # of the toolset (and any sharing across multiple interpreters) agrees on a
    # single location.
    #
    # How it works: it first checks the PKGD_ROOT environment variable; if set,
    # its value is returned verbatim, allowing the location to be overridden
    # (typically when several Tcl instances need to share packages).  Otherwise
    # it falls back to a "pkgd" directory placed parallel to the directory that
    # contains the interpreter's library directory.
    #
    # Tricky/security details: because the environment variable is honored
    # without validation, anything that can set PKGD_ROOT in this process's
    # environment controls where downloaded package files are written and later
    # loaded from; on a multi-user or untrusted system this is a security-
    # relevant input.  The fallback path depends on [info library] being
    # meaningful in the current interpreter.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   The fully qualified (though not necessarily existing) path of the
    #   persistent package root directory.
    # </help>

    global env

    #
    # NOTE: Allow the persistent root directory to be overridden via the
    #       environment.  Typically, this customization will only be needed
    #       if multiple instances of Tcl need to share packages.
    #
    if {[info exists env(PKGD_ROOT)]} then {
      return $env(PKGD_ROOT)
    }

    #
    # NOTE: Fallback to returning a directory parallel to the one containing
    #       the library directory.
    #
    return [file join [file dirname [info library]] pkgd]
  }

  #
  # NOTE: This procedure checks the configured persistent root directory for
  #       downloaded packages.  If any checks fail, a script error is raised.
  #       There are no arguments.  The return value is undefined.
  #
  proc verifyPersistentRootDirectory {} {
    # <help>
    # This procedure validates the configured persistent root directory and
    # ensures it is usable, raising a script error if anything is wrong.  It
    # exists as a guard that the download/persist paths call before writing any
    # persistent package files, so that failures are reported early and
    # clearly rather than mid-copy.
    #
    # How it works: it checks that the persistent-root variable exists and is
    # non-empty, then confirms that the directory either already exists or can
    # be created (it attempts [file mkdir] inside a [catch]).  Any failed check
    # raises a descriptive error.
    #
    # Tricky/security details: as a side effect this may create the persistent
    # root directory on disk.  The directory it validates is where downloaded
    # packages are later stored and from which they may be loaded, so its
    # correctness is relevant to the integrity of what eventually gets executed.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   The result is unspecified on success.  A script error is raised if the
    #   persistent root directory is unset, empty, or cannot be created.
    # </help>

    variable persistentRootDirectory

    if {![info exists persistentRootDirectory]} then {
      error "persistent root directory not set"
    }

    if {[string length $persistentRootDirectory] == 0} then {
      error "persistent root directory is invalid"
    }

    #
    # NOTE: Either the persistent root directory must already exist -OR- we
    #       must be able to create it.
    #
    if {![file isdirectory $persistentRootDirectory] && \
        [catch {file mkdir $persistentRootDirectory}]} then {
      error [appendArgs \
          "persistent root directory \"" $persistentRootDirectory \
          "\" does not exist and could not be created"]
    }
  }

  #
  # NOTE: This procedure returns the name of the package index file for the
  #       language specified by the language argument.  An empty string will
  #       be returned if the language is unsupported or unrecognized.
  #
  proc getPackageIndexFileName { language } {
    # <help>
    # This procedure returns the conventional package index file name for a
    # given target language.  It exists so that the rest of the toolset can ask
    # "what is the index file for this language?" in one place rather than
    # hard-coding the names, which matters when scanning downloaded directories
    # and when deciding what to add to the auto-path.
    #
    # How it works: an empty language or the literal "eagle" yields the Eagle
    # index file name, the literal "tcl" yields the Tcl index file name, and
    # anything else yields the empty string to signal an unsupported or
    # unrecognized language.
    #
    # Arguments:
    #   language -- The target language: the empty string or "eagle" for Eagle,
    #               or "tcl" for native Tcl.
    #
    # Results:
    #   The package index file name for the language, or the empty string when
    #   the language is unsupported or unrecognized.
    # </help>

    if {[string length $language] == 0 || $language eq "eagle"} then {
      return pkgIndex.eagle
    } elseif {$language eq "tcl"} then {
      return pkgIndex.tcl
    } else {
      return ""
    }
  }

  #
  # NOTE: This procedure, which is only used for native Tcl, generates a
  #       "root" package index file (i.e. "pkgIndex.tcl") suitable for
  #       use with native Tcl 8.4 (or higher).  It will recursively scan
  #       for all other native Tcl package index files that are within the
  #       configured persistent root directory and [source] them, thereby
  #       causing all packages located within them to become available.
  #       Since Eagle (by default) already performs recursive searches for
  #       its package index files, this procedure is not needed for Eagle.
  #       The return value is undefined.
  #
  proc maybeCreateRootTclPackageIndex {} {
    # <help>
    # This procedure, used only for native Tcl, generates a top-level
    # "root" package index file in the persistent root directory if one does
    # not already exist.  The generated index recursively scans every
    # subdirectory of the persistent root for native Tcl package index files
    # and sources them, which is what makes packages persisted there become
    # visible to Tcl 8.4 (or higher).  It exists because, unlike Eagle which
    # already searches for index files recursively, native Tcl does not, so a
    # bridging index file must be created.  It is therefore not needed for
    # Eagle.
    #
    # How it works: it verifies the persistent root directory, computes the
    # path of the root index file there, and returns immediately if that file
    # already exists (it never overwrites an existing one).  Otherwise it writes
    # a fixed Tcl script (with line endings normalized) that iterates over the
    # directory tree rooted at the persistent root, sourcing each child
    # directory's index file and discovering further subdirectories as it goes.
    # The generated script also bails out harmlessly under old Tcl or under
    # Eagle.
    #
    # Tricky/security details: the generated index file sources every Tcl
    # package index file found beneath the persistent root.  This means any
    # code in those index files will run when Tcl initializes packages, so the
    # integrity of the persistent root directory tree is security-relevant; an
    # attacker able to write an index file there gains code execution.  The
    # generated file is explicitly marked do-not-edit.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   An empty string in all cases (whether or not the file was created).  A
    #   script error may be raised if the persistent root directory cannot be
    #   verified or the file cannot be written.
    # </help>

    variable persistentRootDirectory

    verifyPersistentRootDirectory
    set persistentDirectory $persistentRootDirectory

    set fileName [file join $persistentDirectory pkgIndex.tcl]
    if {[file exists $fileName]} then {return ""}

    writeFile $fileName [string trim [string map [list \r\n \n] {
###############################################################################
#
# pkgIndex.tcl --
#
# Extensible Adaptable Generalized Logic Engine (Eagle)
# Generated Recursive Package Index File -- PLEASE DO NOT EDIT
#
# Copyright (c) 2007-2012 by Joe Mistachkin.  All rights reserved.
#
# See the file "license.terms" for information on usage and redistribution of
# this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
# RCS: @(#) $Id: $
#
###############################################################################

if {![package vsatisfies [package provide Tcl] 8.4]} {return}
if {[string length [package provide Eagle]] > 0} then {return}

set pkgd(savedDir) $dir; set pkgd(dirs) [list $pkgd(savedDir)]

for {set pkgd(i) 0} {$pkgd(i) < [llength $pkgd(dirs)]} {incr pkgd(i)} {
  set pkgd(dir) [lindex $pkgd(dirs) $pkgd(i)]

  if {$pkgd(i) > 0} then {
    set pkgd(file) [file join $pkgd(dir) pkgIndex.tcl]

    if {[file exists $pkgd(file)]} then {
      set dir $pkgd(dir); source $pkgd(file)
    }
  }

  eval lappend pkgd(dirs) \
      [lsort [glob -nocomplain -types {d} [file join $pkgd(dir) *]]]
}

set dir $pkgd(savedDir); unset -nocomplain pkgd
    }]]

    return ""
  }

  #
  # NOTE: This procedure attempts to download the Package Signing Keys from
  #       the remote server and save it to a local file.  This procedure may
  #       raise script errors.  The fileName argument is the name of the file
  #       where the downloaded data should be written.  This procedure is only
  #       intended to be used from the "pkgr_setup.eagle" tool script and may
  #       go away in later versions of this package.
  #
  # <internal>
  proc downloadAndSaveOpenPgpKeyFile { fileName } {
    # <help>
    # This procedure downloads the Package Signing Keys (OpenPGP key data) from
    # the remote server and saves them to a local file.  These keys are the
    # trust anchor that later OpenPGP signature verification depends on, so
    # obtaining them is a security-critical bootstrap step.  It exists chiefly
    # for use by the "pkgr_setup.eagle" tool script and, per the in-line note,
    # may be removed in a later version.
    #
    # How it works: it tries the configured primary signing-key URI and then,
    # if that fails, the configured fallback (mirror) URI, in order.  For each
    # candidate it performs the deferred [subst] to expand the URI template
    # into an actual URI and then calls [downloadOneUriToFile] to fetch it and
    # write it to the given local file.  The first successful download wins and
    # the procedure returns immediately.  Failures are accumulated and, if no
    # URI succeeds, are raised together as an error (with a synthesized message
    # if for some reason no error was recorded).
    #
    # Tricky/security details: note that the download here is performed with
    # OpenPGP verification DISABLED (both the usePgp and forcePgp arguments to
    # [downloadOneUriToFile] are false).  This is inherent to bootstrapping the
    # key material -- the keys themselves cannot be verified with the keys you
    # are still fetching.  Consequently the authenticity of the downloaded keys
    # rests entirely on the security of the transport (the HTTPS endpoint) and
    # on the trustworthiness of the configured server; if that channel is
    # compromised, an attacker could substitute their own keys and defeat all
    # later signature checks.  The fallback URI is only consulted when the
    # primary fails.
    #
    # Arguments:
    #   fileName -- The local file name where the downloaded OpenPGP key data
    #               should be written.
    #
    # Results:
    #   An empty string on success.  On failure a script error is raised whose
    #   value is a list of the per-URI errors encountered.
    # </help>

    variable baseUri
    variable openPgpKeyUri
    variable openPgpKeyUriFallback
    variable openPgpKeyUrn
    variable openPgpKeyUrnFallback1

    set errors [list]

    foreach substUri [list $openPgpKeyUri $openPgpKeyUriFallback] {
      #
      # NOTE: Attempt to download the Package Signing Keys using the
      #       configured URI.
      #
      if {[catch {
        #
        # NOTE: First, build the actual URI where the Package Signing
        #       Keys should be obtained, performing any applicable
        #       substitutions in the URI prior to using it as the
        #       basis for downloading the Package Signing Keys file.
        #
        set uri [subst $substUri]

        #
        # NOTE: Then, in one step, download the file from the package
        #       file server and write it to the specified local file.
        #
        downloadOneUriToFile $fileName $uri false false
      } result] == 0} then {
        #
        # NOTE: Ok, success.  We are done.
        #
        return ""
      } else {
        #
        # NOTE: Keep track of all errors that are encountered while
        #       trying to download the Package Signing Keys, for later
        #       reporting.
        #
        lappend errors [list $uri $result]
      }
    }

    #
    # NOTE: Make sure there is always an error message.
    #
    if {[llength $errors] == 0} then {
      lappend errors "no URIs are available for package signing keys"
    }

    error $errors
  }

  #
  # NOTE: This procedure returns non-zero if the specified file seems to be
  #       an OpenPGP signature file.  The fileName argument is the name of
  #       the file to check, which may or may not exist.  The nameOnly
  #       argument should be non-zero to ignore the contents of the file.
  #
  proc isOpenPgpSignatureFileName { fileName nameOnly } {
    # <help>
    # This procedure decides whether a given file appears to be an OpenPGP
    # signature file, either by its name alone or by inspecting its contents.
    # It exists so that the download paths can tell signature files apart from
    # the data files they sign, which governs when signature verification is
    # attempted and how downloaded files are paired.
    #
    # How it works: an empty file name is immediately reported as not a
    # signature.  Otherwise it looks at the file extension; only ".txt" and
    # ".asc" are considered candidates.  If nameOnly is requested (or the file
    # does not exist), a matching extension alone is enough to report true.
    # When nameOnly is false and the file exists, it reads the file and defers
    # to the package repository helper [isOpenPgpSignature] to confirm the
    # content actually looks like an OpenPGP signature.
    #
    # Tricky/security details: this is a heuristic, not a cryptographic check;
    # it tells you what a file claims to be, not whether any signature is
    # valid.  The content-based mode reads the entire file into memory.  A
    # nameOnly check can be fooled by a misnamed file, so it should not be
    # relied upon for trust decisions on its own.
    #
    # Arguments:
    #   fileName -- The name of the file to check; it may or may not exist.
    #   nameOnly -- A boolean.  When true, the decision is based solely on the
    #               file name (extension) and the file's contents are not read.
    #
    # Results:
    #   Non-zero (true) if the file appears to be an OpenPGP signature file;
    #   otherwise zero (false).
    # </help>

    if {[string length $fileName] == 0} then {
      return false
    }

    set extension [file extension $fileName]

    if {$extension eq ".txt" || $extension eq ".asc"} then {
      if {!$nameOnly && [file exists $fileName]} then {
        return [::PackageRepository::isOpenPgpSignature \
            [readFile $fileName]]
      } else {
        return true
      }
    } else {
      return false
    }
  }

  #
  # NOTE: This procedure returns non-zero if the specified file seems to be
  #       a Harpy script certificate file.  The fileName argument is the name
  #       of the file to check, which may or may not exist.  The nameOnly
  #       argument should be non-zero to ignore the contents of the file.
  #
  # <notUsed>
  proc isHarpyCertificateFileName { fileName nameOnly } {
    # <help>
    # This procedure decides whether a given file appears to be a Harpy script
    # certificate file, either by its name alone or by inspecting its contents.
    # Harpy certificates carry the digital signatures used to establish trust
    # in Eagle scripts, so distinguishing such files is security-relevant.  It
    # is currently not used by this toolset (it is marked notUsed) but is
    # provided as a counterpart to the OpenPGP signature detector.
    #
    # How it works: an empty file name is reported as not a certificate.
    # Otherwise it checks for the ".harpy" extension.  If nameOnly is requested
    # (or the file does not exist), the matching extension alone is enough to
    # report true.  When nameOnly is false and the file exists, it reads the
    # file and defers to the package repository helper [isHarpyCertificate] to
    # confirm the content actually looks like a Harpy certificate.
    #
    # Tricky/security details: like its OpenPGP counterpart this is only a
    # classification heuristic, not a validity check; it does not verify any
    # signature.  The content-based mode reads the whole file into memory, and
    # a nameOnly result can be defeated by a misnamed file.
    #
    # Arguments:
    #   fileName -- The name of the file to check; it may or may not exist.
    #   nameOnly -- A boolean.  When true, the decision is based solely on the
    #               file name (extension) and the file's contents are not read.
    #
    # Results:
    #   Non-zero (true) if the file appears to be a Harpy certificate file;
    #   otherwise zero (false).
    # </help>

    if {[string length $fileName] == 0} then {
      return false
    }

    set extension [file extension $fileName]

    if {$extension eq ".harpy"} then {
      if {!$nameOnly && [file exists $fileName]} then {
        return [::PackageRepository::isHarpyCertificate \
            [readFile $fileName]]
      } else {
        return true
      }
    } else {
      return false
    }
  }

  #
  # NOTE: This procedure attempts to verify the specified OpenPGP signature
  #       file.  If the forcePgp parameter is non-zero verification will be
  #       attempted even when the specified file does not appear to be an
  #       OpenPGP signature file.  This procedure may raise script errors.
  #
  proc maybeVerifyOpenPgpSignature { fileName forcePgp } {
    # <help>
    # This procedure conditionally verifies an OpenPGP signature file and
    # raises a script error if verification fails.  It is the choke point
    # through which the toolset enforces signature checking on downloaded
    # signature files, and is therefore central to the integrity guarantees of
    # the download path.
    #
    # How it works: it verifies only when forcePgp is true OR when the file
    # already looks like an OpenPGP signature file (decided by name via
    # [isOpenPgpSignatureFileName] with nameOnly true).  When verification is
    # to be performed it probes for and then insists upon an OpenPGP
    # installation (via the package repository helpers
    # [probeForOpenPgpInstallation] and [openPgpMustBeInstalled], the latter of
    # which errors if OpenPGP is unavailable), then calls
    # [verifyOpenPgpSignature].  A false result raises a "bad OpenPGP
    # signature" error naming the file.
    #
    # Tricky/security details: this is a maybe-verify, not an always-verify.
    # When forcePgp is false and the file does not look like a signature file
    # by name, the procedure does NOTHING and returns successfully -- so a
    # caller that wants a file checked unconditionally MUST pass forcePgp true.
    # Verification requires a working OpenPGP installation; if one is missing
    # the procedure errors out rather than silently skipping the check (a
    # fail-closed behavior, which is the safe default).  The actual
    # cryptographic verification, including which keys are trusted, is handled
    # by the repository helper and depends on the previously imported Package
    # Signing Keys.
    #
    # Arguments:
    #   fileName -- The local file name of the OpenPGP signature file to verify.
    #   forcePgp -- A boolean.  When true, verification is attempted even if the
    #               file does not appear (by name) to be a signature file.
    #
    # Results:
    #   The result is unspecified on success (including the case where no
    #   verification was performed).  A script error is raised if OpenPGP is
    #   not installed or the signature does not verify.
    # </help>

    #
    # NOTE: Is this temporary package file actually just an OpenPGP
    #       signature file?  If so, skip it.
    #
    if {$forcePgp || \
        [isOpenPgpSignatureFileName $fileName true]} then {
      #
      # NOTE: Attempt to verify the OpenPGP signature.  If this fails,
      #       an error is raised.
      #
      ::PackageRepository::probeForOpenPgpInstallation
      ::PackageRepository::openPgpMustBeInstalled

      if {![::PackageRepository::verifyOpenPgpSignature \
          $fileName]} then {
        error [appendArgs \
            "bad OpenPGP signature \"" $fileName \"]
      }
    }
  }

  #
  # NOTE: This procedure returns the auto-path for the language specified by
  #       the language argument.  An empty list is returned if the auto-path
  #       does not exist in the target language.  This procedure may raise
  #       script errors.
  #
  proc getAutoPath { language } {
    # <help>
    # This procedure returns the auto-path (the list of directories searched
    # for packages) for a given target language, which may be Eagle or native
    # Tcl.  It exists so that the auto-path manipulation procedures can read the
    # correct language's auto-path regardless of whether this code is itself
    # running under Eagle or under Tcl.
    #
    # How it works: for the Eagle language it returns the global auto-path of
    # the current interpreter when running under Eagle, or evaluates the query
    # inside an Eagle sub-interpreter (after ensuring Eagle is ready) when
    # running under Tcl.  For the Tcl language it does the mirror image: when
    # running under Eagle it asks the primary Tcl interpreter, and when running
    # under Tcl it reads its own global auto-path.  In every case a missing
    # auto-path variable yields the empty list.
    #
    # Tricky details: the cross-language cases bridge between the Eagle and Tcl
    # interpreters, so they rely on that bridge being available (Eagle being
    # ready, or a primary Tcl interpreter existing).  The result reflects the
    # auto-path at the moment of the call only.
    #
    # Arguments:
    #   language -- The target language: the empty string or "eagle" for Eagle,
    #               or "tcl" for native Tcl.
    #
    # Results:
    #   The auto-path list for the requested language, or the empty list if it
    #   does not exist.  An unsupported language raises a script error.
    # </help>

    if {[string length $language] == 0 || $language eq "eagle"} then {
      if {[isEagle]} then {
        if {![info exists ::auto_path]} then {
          return [list]
        }

        return $::auto_path
      } else {
        ::PackageRepository::eagleMustBeReady

        eagle {
          if {![info exists ::auto_path]} then {
            return [list]
          }

          return $::auto_path
        }
      }
    } elseif {$language eq "tcl"} then {
      if {[isEagle]} then {
        tcl eval [tcl primary] {
          if {![info exists ::auto_path]} then {
            return [list]
          }

          return $::auto_path
        }
      } else {
        if {![info exists ::auto_path]} then {
          return [list]
        }

        return $::auto_path
      }
    } else {
      error "unsupported language, no idea how to query auto-path"
    }
  }

  #
  # NOTE: This procedure adds a directory to the auto-path of the specified
  #       language (i.e. native Tcl or Eagle).  The directory will not be
  #       added if it is already present.  The language argument must be the
  #       literal string "eagle" or the literal string "tcl".  The directory
  #       argument is the fully qualified path for the directory to add to
  #       the auto-path.
  #
  proc addToAutoPath { language directory } {
    # <help>
    # This procedure adds a directory to the auto-path of a given target
    # language (Eagle or native Tcl), unless it is already present.  It exists
    # so that freshly downloaded or persisted package directories can be made
    # discoverable by the package machinery of the appropriate language.
    #
    # How it works: for each language it handles both the case of running under
    # that language directly and the cross-language case of reaching the other
    # interpreter (the primary Tcl interpreter from Eagle, or an Eagle
    # sub-interpreter from Tcl).  In every variant it appends the directory to
    # the global auto-path only when the auto-path either does not yet exist or
    # does not already contain that exact directory (an exact-match test).  In
    # the cross-language cases the directory is spliced into a small script via
    # [string map] and brace-quoted so that it survives evaluation in the other
    # interpreter.
    #
    # Tricky/security details: adding a directory to the auto-path means
    # packages found there can be auto-loaded and executed, so this should only
    # ever be called with directories whose contents are trusted.  Matching is
    # exact (not normalized) here, so callers that need normalization or
    # subdirectory-aware checks should use [maybeAddToAutoPath] instead.
    #
    # Arguments:
    #   language  -- The target language: the empty string or "eagle" for
    #                Eagle, or "tcl" for native Tcl.
    #   directory -- The fully qualified directory to add to the auto-path.
    #
    # Results:
    #   The result is unspecified; the procedure is invoked for its side effect
    #   on the auto-path.  An unsupported language raises a script error.
    # </help>

    #
    # NOTE: Add the specified directory to the auto-path if not already
    #       present.
    #
    if {[string length $language] == 0 || $language eq "eagle"} then {
      if {[isEagle]} then {
        if {![info exists ::auto_path] || \
            [lsearch -exact $::auto_path $directory] == -1} then {
          lappend ::auto_path $directory
        }
      } else {
        ::PackageRepository::eagleMustBeReady

        eagle [string map [list %directory% $directory] {
          if {![info exists ::auto_path] || \
              [lsearch -exact $::auto_path {%directory%}] == -1} then {
            lappend ::auto_path {%directory%}
          }
        }]
      }
    } elseif {$language eq "tcl"} then {
      if {[isEagle]} then {
        tcl eval [tcl primary] [string map [list %directory% $directory] {
          if {![info exists ::auto_path] || \
              [lsearch -exact $::auto_path {%directory%}] == -1} then {
            lappend ::auto_path {%directory%}
          }
        }]
      } else {
        if {![info exists ::auto_path] || \
            [lsearch -exact $::auto_path $directory] == -1} then {
          lappend ::auto_path $directory
        }
      }
    } else {
      error "unsupported language, no idea how to modify auto-path"
    }
  }

  #
  # NOTE: This procedure adds a directory to the auto-path of the specified
  #       language (i.e. native Tcl or Eagle).  The directory will not be
  #       added if it is already present.  The language argument must be the
  #       literal string "eagle" or the literal string "tcl".  The directory
  #       argument is the fully qualified path for the directory to add to
  #       the auto-path.  The directory will not be added if it falls under
  #       a directory already in the auto-path.
  #
  proc maybeAddToAutoPath { language directory } {
    # <help>
    # This procedure conditionally adds a directory to the auto-path of a given
    # target language, skipping the addition not only when the directory is
    # already present but also when it already falls underneath some directory
    # already in the auto-path.  It exists to avoid redundant, overlapping
    # auto-path entries (which would cause the same packages to be discovered
    # more than once) and to safely ignore nonexistent directories.
    #
    # How it works: it first rejects an empty or non-directory argument
    # (returning false without doing anything).  It then normalizes the
    # candidate directory and queries the language's auto-path via
    # [getAutoPath].  For each existing auto-path entry it normalizes that
    # entry and performs a prefix comparison: if the candidate's leading
    # characters equal an existing normalized entry, the candidate is
    # considered to reside under it and the addition is skipped.  If no entry
    # covers the candidate, it delegates to [addToAutoPath].
    #
    # Tricky/security details: the containment test is a normalized
    # string-prefix comparison rather than a true path-component test, so it is
    # a pragmatic heuristic (two sibling directories sharing a name prefix
    # could in principle confuse a naive prefix check, though normalization
    # mitigates this in practice).  As with [addToAutoPath], any directory
    # added becomes a place packages may be loaded from, so it must be trusted.
    #
    # Arguments:
    #   language  -- The target language: the empty string or "eagle" for
    #                Eagle, or "tcl" for native Tcl.
    #   directory -- The fully qualified directory to consider adding; it is
    #                normalized before comparison.
    #
    # Results:
    #   Non-zero (true) if the directory was actually added to the auto-path;
    #   zero (false) if it was skipped (missing, not a directory, already
    #   present, or already covered by an existing entry).
    # </help>

    #
    # NOTE: Verify that the directory to be added is valid and exists.  If
    #       not, do nothing.
    #
    if {[string length $directory] == 0 || \
        ![file isdirectory $directory]} then {
      return false
    }

    #
    # NOTE: Normalize the specified directory.  This is necessary so that
    #       we can compare apples-to-apples within the auto-path.
    #
    set directory [file normalize $directory]
    set directoryLength [string length $directory]

    #
    # NOTE: Query the auto-path for the target language.
    #
    set autoPath [getAutoPath $language]

    #
    # NOTE: Check each directory in the auto-path to see if the specified
    #       directory is already underneath it.
    #
    foreach autoDirectory $autoPath {
      #
      # NOTE: Normalize the auto-path directory.  This is necessary so
      #       that we can compare apples-to-apples with the specified
      #       directory.
      #
      set autoDirectory [file normalize $autoDirectory]
      set autoDirectoryLength [string length $autoDirectory]

      #
      # NOTE: Prefix match is impossible if the length of the specified
      #       directory is less than the length of this directory in the
      #       auto-path.
      #
      if {$directoryLength < $autoDirectoryLength} then {
        continue
      }

      #
      # NOTE: If the initial portion of the specified directory is the
      #       same as this directory in the auto-path, it must reside
      #       underneath it.  In that case, there is no need to modify
      #       the auto-path, bail out now.
      #
      set last [expr {$autoDirectoryLength - 1}]

      if {[string range $directory 0 $last] eq $autoDirectory} then {
        return false
      }
    }

    #
    # NOTE: At this point, it is pretty safe to assume that the specified
    #       directory is not in the auto-path, nor underneath a directory
    #       within the auto-path.
    #
    addToAutoPath $language $directory

    return true
  }

  #
  # NOTE: This procedure attempts to verify that an instance of Mono and its
  #       associated runtimes are installed locally.  There are no arguments.
  #       The return value is non-zero if Mono appears to be installed and
  #       available for use; otherwise, the return value is zero.
  #
  proc isMonoInstalled {} {
    # <help>
    # This procedure attempts to determine whether a usable Mono installation
    # (and its runtimes) is present locally.  It exists to support platform
    # selection: knowing whether Mono is available helps decide whether the
    # "msil" (managed CLR) package platform can be used on non-Windows systems.
    #
    # How it works: it expands the configured Mono probe command template via
    # [subst] (substituting the configured Mono executable name) and runs it
    # with [exec] inside a [catch].  Under Eagle it additionally requires the
    # external process to report success.  Any execution failure is treated as
    # "not installed".  On success it matches the captured output against the
    # configured Mono version pattern; only a match counts as installed.
    #
    # Tricky/security details: this runs an external program whose name comes
    # from configuration, so an attacker able to influence that configuration
    # (or the executable search path) could cause an arbitrary program to be
    # executed during probing.  The result is only as trustworthy as the
    # configured command and pattern.  A failure to execute is deliberately
    # swallowed and reported as not installed rather than raising an error.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Non-zero (true) if Mono appears installed and usable; otherwise zero
    #   (false).
    # </help>

    variable monoFileNameOnly
    variable monoInstalledCommand
    variable monoInstalledPattern

    if {[isEagle]} then {
      if {[catch {
        eval exec -success Success [subst $monoInstalledCommand]
      } result]} then {
        return false
      }
    } else {
      if {[catch {
        eval exec [subst $monoInstalledCommand]
      } result]} then {
        return false
      }
    }

    if {![info exists result] || \
        ![regexp -- $monoInstalledPattern $result]} then {
      return false
    }

    return true
  }

  #
  # NOTE: This procedure attempts to verify that an instance of .NET Core
  #       and its associated runtimes are installed locally.  There are no
  #       arguments.  The return value is non-zero if .NET Core appears to
  #       be installed and available for use; otherwise, the return value
  #       is zero.
  #
  proc isDotNetCoreInstalled {} {
    # <help>
    # This procedure attempts to determine whether a usable .NET Core
    # installation (and its runtimes) is present locally.  Like its Mono
    # counterpart, it exists to support platform selection, helping decide
    # whether the "msil" (managed CLR) package platform is usable on
    # non-Windows systems.
    #
    # How it works: it expands the configured .NET Core probe command template
    # via [subst] (substituting the configured dotnet executable name) and runs
    # it with [exec] inside a [catch].  Under Eagle it additionally requires the
    # process to report success.  Any execution failure is treated as "not
    # installed".  On success it matches the trimmed captured output against the
    # configured .NET Core version pattern; only a match counts as installed.
    #
    # Tricky/security details: this runs an external program whose name comes
    # from configuration; the same caveats as for the Mono probe apply -- an
    # attacker controlling that configuration or the executable search path
    # could cause an arbitrary program to run.  Execution failures are
    # swallowed and reported as not installed rather than raising an error.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Non-zero (true) if .NET Core appears installed and usable; otherwise
    #   zero (false).
    # </help>

    variable dotnetFileNameOnly
    variable dotnetInstalledCommand
    variable dotnetInstalledPattern

    if {[isEagle]} then {
      if {[catch {
        eval exec -success Success [subst $dotnetInstalledCommand]
      } result]} then {
        return false
      }
    } else {
      if {[catch {
        eval exec [subst $dotnetInstalledCommand]
      } result]} then {
        return false
      }
    }

    if {![info exists result] || \
        ![regexp -- $dotnetInstalledPattern [string trim $result]]} then {
      return false
    }

    return true
  }

  #
  # NOTE: This procedure attempts to verify that some runtime is available to
  #       run CLR applications locally (e.g. the .NET Framework or Mono JIT).
  #       There are no arguments.  The return value is non-zero if it appears
  #       that CLR applications should be runnable locally; otherwise, the
  #       return value is zero.
  #
  proc canUseMsilPlatform {} {
    # <help>
    # This procedure decides whether the local machine can run managed CLR
    # (MSIL) applications, which determines whether the "msil" package platform
    # is eligible during platform detection and verification.  It exists to
    # gate selection of MSIL-targeted package files to systems that can
    # actually execute them.
    #
    # How it works: on Windows it assumes a compatible .NET Framework is always
    # present and returns true outright.  On every other platform it returns
    # true only if either Mono or .NET Core is detected as installed (via
    # [isMonoInstalled] or [isDotNetCoreInstalled]).
    #
    # Tricky/security details: per the in-line HACK notes the Windows answer is
    # an unconditional assumption, not an actual probe, so it can be optimistic
    # on stripped-down Windows installs.  On other platforms the answer
    # inherits the external-process caveats of the underlying installation
    # probes.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Non-zero (true) if CLR applications should be runnable locally;
    #   otherwise zero (false).
    # </help>

    if {[isWindows]} then {
      #
      # HACK: Assume that all Windows operating systems have a compatible
      #       version of the .NET Framework is installed -AND- that it can
      #       be used to run any CLR application.
      #
      return true
    } else {
      #
      # HACK: On all other platforms, assume that Mono -OR- .NET Core can
      #       be used to run any CLR application.
      #
      return [expr {[isMonoInstalled] || [isDotNetCoreInstalled]}]
    }
  }

  #
  # NOTE: This procedure verifies that the specified value is indeed a valid
  #       package name.  The packageName argument is the value to verify.
  #       This procedure may raise script errors.
  #
  # <internal>
  proc verifyPackageName { packageName } {
    # <help>
    # This procedure validates that a value is a well-formed package name,
    # raising a script error if it is not.  It exists as an input-validation
    # guard called before a package name is used to build server paths and
    # request URIs.
    #
    # How it works: a non-empty package name must match a case-insensitive
    # pattern requiring it to start with a letter and otherwise consist only of
    # alphanumeric characters and dots; anything else raises an error.  An
    # empty package name is permitted (it is treated as "unspecified" by
    # callers, which may later guess it) and passes without error.
    #
    # Tricky/security details: this is a security-relevant whitelist.  By
    # restricting package names to a safe alphabet it prevents path-traversal
    # sequences, slashes, or query-string metacharacters from being smuggled
    # into the directory and URI construction that consumes the name.
    #
    # Arguments:
    #   packageName -- The candidate package name to validate; the empty string
    #                  is allowed.
    #
    # Results:
    #   The result is unspecified on success.  A script error is raised when a
    #   non-empty name does not match the required pattern.
    # </help>

    if {[string length $packageName] > 0 && \
        ![regexp -nocase -- {^[A-Z][0-9A-Z\.]*$} $packageName]} then {
      error "package name must be alphanumeric and start with a letter"
    }
  }

  #
  # NOTE: This procedure verifies that the specified value is indeed a valid
  #       patch level.  The patchLevel argument is the value to verify.  This
  #       procedure may raise script errors.
  #
  # <internal>
  proc verifyPackagePatchLevel { patchLevel } {
    # <help>
    # This procedure validates that a value is a well-formed package patch
    # level (version), raising a script error if it is not.  It exists as an
    # input-validation guard for version strings.
    #
    # How it works: a non-empty patch level must match a dotted-decimal pattern
    # of two to four numeric components (for example, major.minor with up to
    # two further optional components); anything else raises an error.  An
    # empty patch level is allowed and passes without error.
    #
    # Tricky/security details: like the package-name check this is a whitelist
    # that confines the value to digits and dots, preventing unexpected
    # characters from reaching path or URI construction.
    #
    # Arguments:
    #   patchLevel -- The candidate patch level to validate; the empty string
    #                 is allowed.
    #
    # Results:
    #   The result is unspecified on success.  A script error is raised when a
    #   non-empty value is not in dotted-decimal notation.
    # </help>

    if {[string length $patchLevel] > 0 && \
        ![regexp -nocase -- {^\d+\.\d+(?:\.\d+){0,2}$} $patchLevel]} then {
      error "patch level must use dotted decimal notation"
    }
  }

  #
  # NOTE: This procedure verifies the combination of language and version
  #       specified by the caller.  The language argument must be one of the
  #       literal strings "eagle", "tcl", or "client".  The version argument
  #       must be one of the literal strings "8.4", "8.5", "8.6", or "8.7"
  #       when the language is "tcl" -OR- the literal string "1.0" when the
  #       language is "eagle".  When the language is "client", the version
  #       match the major and minor portions of "1.0" and any remaining
  #       portions must be numeric.  The varName argument is the name of a
  #       scalar variable in the context of the immediate caller that will
  #       receive a boolean value indicating if the specified language is
  #       actually a reference to the package downloader client itself.
  #
  # <internal>
  proc verifyLanguageAndVersion { language version varName } {
    # <help>
    # This procedure validates a language-and-version combination and reports,
    # via an out-parameter, whether the language refers to the package
    # downloader client itself.  It exists as an input-validation guard used
    # throughout the download paths and as the single place that distinguishes
    # client files from ordinary package files (which affects where files are
    # stored).
    #
    # How it works: an optional caller variable (named by varName) is linked
    # via [upvar] and initialized to false.  For an empty language or "eagle",
    # the version must be exactly "1.0".  For "tcl", the version must be one of
    # the supported Tcl releases ("8.4", "8.5", "8.6", or "8.7").  For
    # "client", the version must match the major/minor "1.0" with any further
    # numeric components, and the out-parameter is set to true.  Any other
    # language, or a version not allowed for the language, raises a script
    # error.
    #
    # Tricky/security details: this is a whitelist of acceptable languages and
    # versions, restricting the values that flow into server paths.  The
    # isClient out-parameter is consequential: when true, callers persist files
    # into the client directory rather than the package "packages" subtree, so
    # a misclassification would place files in the wrong location.
    #
    # Arguments:
    #   language -- The language to validate: empty string or "eagle", "tcl",
    #               or "client".
    #   version  -- The version to validate; allowed values depend on the
    #               language as described above.
    #   varName  -- The name of a scalar variable in the immediate caller that
    #               receives a boolean indicating whether the language is the
    #               client itself.  May be empty to skip the out-parameter.
    #
    # Results:
    #   The result is unspecified on success; the validation outcome is
    #   communicated via the out-parameter and via raised errors.  A script
    #   error is raised for an unsupported language or version.
    # </help>

    if {[string length $varName] > 0} then {
      upvar 1 $varName isClient
    }

    set isClient false

    if {[string length $language] == 0 || $language eq "eagle"} then {
      if {$version ne "1.0"} then {
        error "unsupported Eagle version"
      }
    } elseif {$language eq "tcl"} then {
      if {$version ne "8.4" && $version ne "8.5" && \
          $version ne "8.6" && $version ne "8.7"} then {
        error "unsupported Tcl version"
      }
    } elseif {$language eq "client"} then {
      if {![regexp -- {^1\.0(?:\.\d+){0,2}$} $version]} then {
        error "unsupported client version"
      }

      set isClient true
    } else {
      error "unsupported package language"
    }
  }

  #
  # NOTE: This procedure returns the name of the current platform.  There are
  #       no arguments.  An empty string will be returned if the name of the
  #       current platform cannot be determined for any reason.
  #
  # <internal>
  proc getPlatform {} {
    # <help>
    # This procedure returns the canonical platform name for the current
    # machine, as used to select platform-specific package files on the server
    # (for example, "win64-x64", "linux-x64", or "macosx-x64").  It exists to
    # map the interpreter's platform/OS/machine description onto the naming
    # convention the package file server uses.
    #
    # How it works: it reads the global tcl_platform array (platform, machine,
    # and os elements) and runs nested [switch] statements to translate the
    # combination into a known platform name.  Unix/Darwin and Unix/Linux are
    # mapped by machine (with several Linux architectures synthesized by
    # appending the raw machine name), and Windows is mapped by machine into
    # win32-/win64- names.  Combinations it does not recognize fall through.
    #
    # Tricky details: it depends on tcl_platform being populated; if the
    # platform element is missing, or the specific platform/os/machine
    # combination is not handled, it returns the empty string rather than
    # erroring.  Callers must therefore be prepared for an empty result meaning
    # "could not determine the platform".
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   The canonical platform name string, or the empty string when the
    #   platform cannot be determined.
    # </help>

    global tcl_platform

    if {[info exists tcl_platform(platform)]} then {
      set platform $tcl_platform(platform)

      if {[info exists tcl_platform(machine)]} then {
        set machine $tcl_platform(machine)
      } else {
        set machine ""
      }

      if {[info exists tcl_platform(os)]} then {
        set os $tcl_platform(os)
      } else {
        set os ""
      }

      switch -exact -- $platform {
        unix {
          switch -exact -- $os {
            Darwin {
              switch -exact -- $machine {
                "Power Macintosh" {
                  return macosx-power
                }
                x86_64 {
                  return macosx-x64
                }
              }
            }
            Linux {
              switch -exact -- $machine {
                i386 {
                  return linux-x86
                }
                x86_64 {
                  return linux-x64
                }
                alpha -
                armv4l -
                armv6l -
                armv7l -
                ia64 -
                ppc {
                  return [appendArgs linux- $machine]
                }
              }
            }
          }
        }
        windows {
          switch -exact -- $machine {
            intel -
            ia32_on_win64 {
              return win32-x86
            }
            arm {
              return [appendArgs win32- $machine]
            }
            amd64 {
              return win64-x64
            }
            ia64 -
            arm64 {
              return [appendArgs win64- $machine]
            }
          }
        }
      }
    }

    return ""
  }

  #
  # NOTE: This procedure verifies that the specified value is indeed a valid
  #       version identifier.  The versionId argument is the value to verify.
  #       This procedure may raise script errors.
  #
  # <internal>
  proc verifyVersionId { versionId } {
    # <help>
    # This procedure validates that a value is a well-formed version
    # identifier, raising a script error if it is not.  It exists as the
    # input-validation guard used by [useVersionId] before a check-in
    # identifier is placed into the branch/version field of request URIs.
    #
    # How it works: a non-empty identifier must match a case-insensitive
    # hexadecimal pattern (matching the form of a Fossil check-in hash);
    # anything else raises an error.  An empty identifier is allowed and
    # passes without error.
    #
    # Tricky/security details: this whitelist confines the value to hexadecimal
    # characters, preventing injection of slashes, query metacharacters, or
    # other unexpected content into the URIs that incorporate the version.
    #
    # Arguments:
    #   versionId -- The candidate version identifier to validate; the empty
    #                string is allowed.
    #
    # Results:
    #   The result is unspecified on success.  A script error is raised when a
    #   non-empty value is not hexadecimal.
    # </help>

    if {[string length $versionId] > 0 && \
        ![regexp -nocase -- {^[0-9A-F]*$} $versionId]} then {
      error "version Id must be hexadecimal"
    }
  }

  #
  # NOTE: This procedure verifies the platform specified by the caller.  The
  #       platform argument must be an empty string -OR- one of the literal
  #       strings "msil" or "neutral", or one of the values returned by the
  #       [getPlatform] procedure.  An empty string means that the associated
  #       entity does not require a specific platform.  The varName argument
  #       is the name of a variable in the context of the immediate caller
  #       that will receive a modified platform name, if applicable.  Upon
  #       failure, a script error will be raised.  The return value is
  #       undefined.
  #
  # <internal>
  proc verifyPlatform { platform varName } {
    # <help>
    # This procedure validates a platform name and, for the special automatic
    # case, detects an appropriate platform for the entity being downloaded,
    # writing the chosen platform back through an out-parameter.  It exists as
    # the input-validation and platform-selection guard used by the download
    # procedures, and it is the most involved of the verify helpers because the
    # automatic case actually contacts the network.
    #
    # How it works: the platform name is matched exactly and case-sensitively.
    # The empty string means "automatically detect".  In that case the
    # procedure reaches into the caller's frame (via [upvar]) to read the
    # ambient language, version, and optionally packageName, fileNames, and
    # usePgp values; ensures a login exists by calling
    # [maybeResetCookieAndLoginSimple]; downloads the set of platforms
    # supported for the package via [downloadAllPlatforms]; and then chooses
    # the first compatible platform from a candidate list -- the current
    # machine platform (from [getPlatform]), then "neutral", and finally
    # "msil" if [canUseMsilPlatform] reports MSIL is usable.  The chosen value
    # is stored through the out-parameter named by varName.  The literal "msil"
    # is accepted only if MSIL is actually usable.  A fixed set of explicit
    # platform names is accepted verbatim, and anything else raises an error.
    #
    # Tricky/security details: the automatic case has significant side effects
    # for a procedure named "verify" -- it logs in and performs a network
    # download of a (OpenPGP-verifiable) manifest.  It relies on the caller's
    # frame actually containing language and version variables and errors if it
    # cannot find them.  Because platform selection decides which package
    # binaries are fetched and ultimately loaded, it is security-relevant; the
    # usePgp flag read from the caller controls whether the downloaded platform
    # manifest is signature-verified.  If no candidate platform is supported by
    # the package, an error is raised rather than silently choosing one.
    #
    # Arguments:
    #   platform -- The platform to validate: the empty string (auto-detect),
    #               "msil", "neutral", or one of the explicit win32-/win64-
    #               platform names (or a value produced by [getPlatform]).
    #   varName  -- The name of a caller variable that receives the resolved
    #               platform name when auto-detection is performed.  May be
    #               empty to skip writing the out-parameter.
    #
    # Results:
    #   The result is unspecified on success.  A script error is raised when
    #   the language or version cannot be detected, when "msil" is requested
    #   but unsupported, when no compatible platform can be detected, or when
    #   the platform name is unsupported.
    # </help>

    #
    # NOTE: The platform name must be matched exactly and case-sensitively.
    #
    switch -exact -- $platform {
      "" {
        #
        # NOTE: The empty string means "attempt to automatically detect" the
        #       necessary platform based on context information that may be
        #       present in the context of the immediate caller.  If this is
        #       not possible, a script error will be raised.
        #
        upvar 1 language language

        if {![info exists language]} then {
          error "unable to detect language"
        }

        upvar 1 version version

        if {![info exists version]} then {
          error "unable to detect version"
        }

        upvar 1 packageName packageName

        if {[info exists packageName]} then {
          set localPackageName $packageName
        } else {
          set localPackageName ""
        }

        upvar 1 fileNames fileNames

        if {[info exists fileNames]} then {
          set localFileNames $fileNames
        } else {
          set localFileNames [list]
        }

        upvar 1 usePgp usePgp

        if {[info exists usePgp]} then {
          set localUsePgp $usePgp
        } else {
          set localUsePgp false
        }

        #
        # NOTE: Since not all potential callers to this procedure may login
        #       first, attempt to do that now, if necessary.
        #
        maybeResetCookieAndLoginSimple

        #
        # NOTE: Download the list of platforms associated with this package
        #       from the package repository server.  This may fail and raise
        #       a script error.
        #
        set platforms [downloadAllPlatforms \
            $language $version $localPackageName $localFileNames $localUsePgp]

        if {[string length $varName] > 0} then {
          upvar 1 $varName newPlatform
        }

        #
        # NOTE: First, check the current platform and the neutral platform,
        #       in that order, to see if that platform is supported by the
        #       package being saught.
        #
        set thesePlatforms [list [getPlatform] neutral]

        #
        # NOTE: Next, optionally, allow the "msil" platform to be checked.
        #       Currently, this is always applicable on Windows; however,
        #       on all other platforms this depends on having Mono and its
        #       associated runtimes installed locally.
        #
        if {[canUseMsilPlatform]} then {
          lappend thesePlatforms msil
        }

        #
        # NOTE: Check each applicable platform, in order, stopping when a
        #       supported platform is found for the package being saught.
        #
        foreach thisPlatform $thesePlatforms {
          if {[lsearch -exact $platforms $thisPlatform] != -1} then {
            set newPlatform $thisPlatform
            return
          }
        }

        #
        # NOTE: If this point is reached, there are no supported platforms
        #       that are compatible with the current one for the specified
        #       package.
        #
        error "could not automatically detect platform"
      }
      msil {
        #
        # NOTE: Forbid the "msil" platform if it is not available for use.
        #
        if {![canUseMsilPlatform]} then {
          error "platform \"msil\" does not appear to be supported"
        }
      }
      neutral -
      win32-arm -
      win32-x86 -
      win64-arm64 -
      win64-ia64 -
      win64-x64 {
        #
        # NOTE: This platform name is supported verbatim, do nothing.
        #
      }
      default {
        error "unsupported package platform"
      }
    }
  }

  #
  # NOTE: This procedure checks the current login cookie to make sure that
  #       it exists -AND- conforms to the correct format.
  #
  proc haveValidLoginCookie {} {
    # <help>
    # This procedure checks whether the currently configured HTTP(S) login
    # cookie exists and is well-formed.  It exists so that the request and
    # login/logout procedures can cheaply decide whether they are already
    # authenticated before attaching a cookie or attempting a (re)login.
    #
    # How it works: it returns false if the cookie variable does not exist.
    # Under Eagle, or under Tcl 8.5 or higher, it additionally requires the
    # cookie to be a strict, well-formed list.  It then requires the cookie to
    # have exactly two elements (the cookie name and its value); any other
    # length is rejected.
    #
    # Tricky/security details: this only checks the shape of the cookie, not
    # whether the server still considers it valid -- a structurally fine but
    # expired or revoked cookie will still pass.  The strict-list test is
    # skipped on pre-8.5 Tcl, where that introspection is unavailable.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Non-zero (true) if a structurally valid two-element login cookie is
    #   present; otherwise zero (false).
    # </help>

    variable loginCookie

    if {![info exists loginCookie]} then {
      return false
    }

    if {[isEagle] || \
        ([info exists tcl_version] && $tcl_version >= 8.5)} then {
      if {![string is list -strict $loginCookie]} then {
        return false
      }
    }

    if {[llength $loginCookie] != 2} then {
      return false
    }

    return true
  }

  #
  # NOTE: This procedure issues a request to an HTTP(S) server.  It returns
  #       the raw response data verbatim.  It may raise a script error.  It
  #       will always use the currently configured HTTP(S) login cookie, if
  #       any; therefore, it should really only be used for requests to the
  #       package file server.  The uri argument is the fully qualified URI
  #       to request.  The allowHtml argument should be non-zero if raw HTML
  #       should be allowed in the response data.
  #
  proc getPackageFile { uri {allowHtml false} } {
    # <help>
    # This procedure issues an HTTP(S) request to the package file server and
    # returns the raw response data verbatim.  It is the single low-level
    # transport used by virtually every download in the toolset, and it always
    # attaches the currently configured login cookie (if any), so it must only
    # be pointed at the package file server -- never at arbitrary URIs, lest the
    # authentication cookie be leaked to a third party.
    #
    # How it works: under Eagle it first sanity-checks the library build,
    # requiring the TEST and NETWORK compile-options (downloading is refused
    # without them) and ensuring a web-client callback is installed.  If a
    # valid login cookie is present, it arranges (through a GetWebRequest
    # callback) to add a Cookie header carrying the joined cookie name and
    # value, then calls [uri download] with an inline, network-timeout
    # request; without a cookie it downloads the same way but without the
    # header.  Under native Tcl it builds an options list (binary mode, plus a
    # Cookie header when a valid cookie exists) and delegates to the package
    # repository helper [getFileViaHttp], honoring the quiet flag.
    #
    # Tricky/security details: the login cookie is sent on every request, which
    # is precisely why this must target only the trusted package file server.
    # As a defense against a common server error mode, unless allowHtml is set,
    # a response beginning with an HTML doctype is treated as an error (Fossil
    # returns an HTML error page, for example "Artifact does not exist"),
    # preventing such a page from being mistaken for package content.  The
    # HTTPS transport is relied upon to protect the cookie and the downloaded
    # data in transit; this procedure performs NO signature or hash
    # verification of the content -- that is the responsibility of higher-level
    # callers (for example, via [maybeVerifyOpenPgpSignature]).
    #
    # Arguments:
    #   uri       -- The fully qualified URI to request; it must be a package
    #                file server URI.
    #   allowHtml -- Optional boolean (default false).  When false, an HTML
    #                response is rejected as an error; when true, HTML is
    #                returned as-is.
    #
    # Results:
    #   The raw response data as a (possibly binary) string.  A script error is
    #   raised on missing compile-options, callback setup failure, transport
    #   failure, or an unexpected HTML response.
    # </help>

    variable loginCookie
    variable quiet

    if {[isEagle]} then {
      if {![info exists ::eagle_platform(compileOptions)]} then {
        error "missing compile options from Eagle platform array"
      }

      if {[lsearch -exact -- \
          $::eagle_platform(compileOptions) TEST] == -1} then {
        error "cannot download: library missing TEST compile-option"
      }

      if {[lsearch -exact -- \
          $::eagle_platform(compileOptions) NETWORK] == -1} then {
        error "cannot download: library missing NETWORK compile-option"
      }

      if {![object invoke Eagle._Tests.Default \
          TestHasScriptNewWebClientCallback ""]} then {
        set error null

        set code [object invoke Eagle._Tests.Default \
            TestSetScriptNewWebClientCallback "" true true error]

        if {$code ne "Ok"} then {
          error [getStringFromObjectHandle $error]
        }
      }

      if {[haveValidLoginCookie]} then {
        set script [object create String {
          if {[methodName ToString] eq "GetWebRequest"} then {
            webRequest Headers.Add Cookie [join $loginCookie =]
          }
        }]

        set data [uri download \
            -timeouttype network -inline \
            -webclientdata $script -- $uri]
      } else {
        set data [uri download \
            -timeouttype network -inline -- $uri]
      }
    } else {
      set options [list -binary true]

      if {[haveValidLoginCookie]} then {
        lappend options -headers [list Cookie [join $loginCookie =]]
      }

      set data [eval ::PackageRepository::getFileViaHttp \
          [list $uri] [list 20] [list stdout] [list $quiet] $options]
    }

    #
    # HACK: Check for the typical Fossil error response(s), which is an
    #       HTML page that may contain something like "Artifact 'X' does
    #       not exist in this repository").
    #
    if {!$allowHtml && [string range $data 0 14] eq "<!DOCTYPE html>"} then {
      error "bad package file response data, appears to be HTML page"
    }

    return $data
  }

  #
  # NOTE: This procedure returns the prefix for fully qualified variable
  #       names that MAY be present in the global namespace.  There are
  #       no arguments.
  #
  proc getDownloadVarNamePrefix {} {
    # <help>
    # This procedure returns the fixed prefix for the fully qualified global
    # variable names that the package downloader client may consult (for
    # example, when locating configured API keys).  It exists to keep that
    # well-known prefix in one place rather than scattering the literal across
    # callers.
    #
    # How it works: it simply returns the constant prefix string.  An in-line
    # TODO notes that these variables are currently global and might be made
    # non-global in the future.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   The variable-name prefix string used to find download-related global
    #   variables (such as API keys).
    # </help>

    return ::pkgd_; # TODO: Make non-global?
  }

  #
  # NOTE: This procedure resets the currently configured login cookie, if
  #       any, and then attempts to login using the configured package
  #       repository server API key -OR- using the public access account.
  #       Upon success, it will set the login cookie to the one from the
  #       raw response data.  Upon failure, a script error will be raised.
  #       There are no arguments.
  #
  # <public>
  proc resetCookieAndLoginSimple {} {
    # <help>
    # This procedure logs in to the package file server without the caller
    # having to supply credentials, preferring a configured API key and
    # falling back to the public account.  It exists as the convenient,
    # zero-argument entry point that most download operations use to establish
    # an authenticated session.
    #
    # How it works: it asks the package repository helper [getApiKeys] (scoped
    # by the download variable-name prefix) for an API key and takes the first
    # one.  If an API key is found, it logs in by calling [resetCookieAndLogin]
    # with the key used as both the user name and the password.  Otherwise, if
    # a public user name and password are both configured, it logs in with
    # those.  If neither is available it raises an error.
    #
    # Tricky/security details: an API key is used as both the user name and
    # password, which is how the server's API-key authentication is expected to
    # work.  The public-account credentials are a fallback and are embedded in
    # configuration; while not treated as a true secret, they still gate access
    # and should not be shared outside parties entitled to use this client.
    # The underlying login resets any existing cookie first, so calling this
    # always establishes a fresh session.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   An empty string on success (the login cookie is set as a side effect).
    #   A script error is raised when no API key and no public credentials are
    #   available, or when the underlying login fails.
    # </help>

    variable publicPassword
    variable publicUserName

    set apiKey [lindex [::PackageRepository::getApiKeys \
        [getDownloadVarNamePrefix] true] 0]

    if {[string length $apiKey] > 0} then {
      return [resetCookieAndLogin $apiKey $apiKey]
    }

    if {[string length $publicUserName] > 0 && \
        [string length $publicPassword] > 0} then {
      return [resetCookieAndLogin $publicUserName $publicPassword]
    }

    error "missing API keys and no public login credentials configured"
  }

  #
  # NOTE: This procedure attempts to login using the configured package
  #       repository server API key -OR- using the public access account,
  #       if not already logged in.  Upon success, it will set the login
  #       cookie to the one from the raw response data.  Upon failure, a
  #       script error will be raised.  There are no arguments.
  #
  # <internal>
  proc maybeResetCookieAndLoginSimple {} {
    # <help>
    # This procedure ensures an authenticated session exists, logging in only
    # if one does not already.  It exists so that procedures which may be
    # invoked without a prior explicit login (for example, platform detection)
    # can guarantee a usable cookie without forcing an unnecessary re-login.
    #
    # How it works: it checks [haveValidLoginCookie]; if a valid cookie is
    # already present it does nothing, otherwise it delegates to
    # [resetCookieAndLoginSimple] to establish one.
    #
    # Tricky/security details: this is idempotent in the common case -- it will
    # not disturb an existing valid session.  Because the validity check is
    # only structural (see [haveValidLoginCookie]), a stale-but-well-formed
    # cookie will not trigger a fresh login here; the eventual server request
    # would surface such a problem.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   The result is unspecified; on return a login cookie should be present.
    #   A script error is raised if a needed login fails.
    # </help>

    variable loginCookie

    #
    # NOTE: Attempt to verify that we are currently logged in.  If so, do
    #       nothing; otherwise, attempt to login.
    #
    if {![haveValidLoginCookie]} then {
      resetCookieAndLoginSimple
    }
  }

  #
  # NOTE: This procedure resets the currently configured login cookie, if
  #       any, and then attempts to login using the specified user name and
  #       password.  Upon success, it will set the login cookie to the one
  #       from the raw response data.  Upon failure, a script error will be
  #       raised.  The userName argument must be the name of a package file
  #       server user with at least Fossil Check-Out (o) permissions on the
  #       package file server.  The password argument must be the plaintext
  #       password that is associated with the specified user name.
  #
  # <public>
  proc resetCookieAndLogin { userName password } {
    # <help>
    # This procedure logs in to the package file server with an explicit user
    # name and password, discarding any prior cookie and capturing a fresh
    # authentication cookie from the response.  It is the workhorse beneath the
    # simpler login helpers and the public entry point for credential-based
    # login.
    #
    # How it works: it expands the login URI template via [subst] (which
    # interpolates and URI-escapes the supplied user name and password), clears
    # any existing login cookie, and issues the request via [getPackageFile].
    # It then extracts the auth token and the login-cookie name from the JSON-
    # ish response using regular expressions, erroring if either is absent.  On
    # success it stores the two-element list of cookie name and auth token as
    # the new login cookie.
    #
    # Tricky/security details: the credentials travel inside the request URI's
    # query string (after escaping), so the confidentiality of those
    # credentials depends entirely on the HTTPS transport -- they would be
    # exposed over plain HTTP or in any logging of full URIs.  The response is
    # parsed with regular expressions rather than a real JSON parser; the
    # in-line TODO/HACK notes flag that these patterns must be kept in sync
    # with the server's response format.  The old cookie is reset before the
    # request, so a failed login leaves the client unauthenticated rather than
    # holding a stale cookie.  The auth token captured here is later used to
    # build the logout URI.
    #
    # Arguments:
    #   userName -- A package file server user with at least Fossil Check-Out
    #               (o) permission, or an API key acting as the user name.
    #   password -- The plaintext password (or API key) for that user.
    #
    # Results:
    #   An empty string on success (the login cookie is set as a side effect).
    #   A script error is raised if the response is missing the auth token or
    #   the login-cookie name, or if the request itself fails.
    # </help>

    variable baseUri
    variable loginCookie
    variable loginUri
    variable loginUrn

    #
    # NOTE: Build the full URI for the login request, performing any
    #       applicable substitutions in the URI prior to using it as
    #       the basis for logging into the repository.
    #
    set uri [subst $loginUri]

    #
    # NOTE: Reset the old login cookie, if any.  Then, issue a new login
    #       request, capturing the raw response data.
    #
    set loginCookie [list]; set data [getPackageFile $uri]

    #
    # NOTE: Attempt to extract the necessary values from the raw response
    #       data.
    #
    set pattern(1) {"authToken":"(.*?)"}; # TODO: *HACK* Keep updated.

    if {![regexp -- $pattern(1) $data dummy authToken]} then {
      error "login response missing \"authToken\""
    }

    set pattern(2) {"loginCookieName":"(.*?)"}; # TODO: *HACK* Keep updated.

    if {![regexp -- $pattern(2) $data dummy loginCookieName]} then {
      error "login response missing \"loginCookieName\""
    }

    #
    # NOTE: Set the login cookie to the one freshly extracted from the raw
    #       response data.
    #
    set loginCookie [list $loginCookieName $authToken]

    #
    # NOTE: Always return an empty string (i.e. and not any response data).
    #
    return ""
  }

  #
  # NOTE: This procedure attempts to logout using the currently configured
  #       login cookie, if any, and then resets the login cookie.  There
  #       are no arguments.  This procedure may raise a script error.
  #
  # <public>
  proc logoutAndResetCookie {} {
    # <help>
    # This procedure logs out of the package file server using the current
    # session and then clears the local login cookie.  It exists to cleanly
    # terminate an authenticated session, both server-side and locally.
    #
    # How it works: it first requires a valid login cookie (erroring if there
    # is none).  It extracts the auth token from the cookie, expands the logout
    # URI template via [subst] (which interpolates and escapes the token), and
    # issues the request via [getPackageFile].  It confirms the logout by
    # matching the response against a pattern indicating the session is now the
    # anonymous "nobody" user, erroring if that confirmation is absent.
    # Finally it resets the local login cookie to empty.
    #
    # Tricky/security details: as with login, the response is checked with a
    # regular expression whose pattern (per the in-line TODO/HACK note) must
    # track the server's response format.  The local cookie is only cleared
    # after a confirmed logout; if the server response does not confirm logout,
    # an error is raised and the local cookie is left intact.  The auth token
    # is carried in the logout URI's query string, so HTTPS transport is again
    # relied upon to protect it.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   An empty string on success (the login cookie is cleared as a side
    #   effect).  A script error is raised if there is no valid cookie, the
    #   logout is not confirmed, or the request fails.
    # </help>

    variable baseUri
    variable loginCookie
    variable logoutUri
    variable logoutUrn

    #
    # NOTE: Attempt to verify that we are currently logged in.
    #
    if {![haveValidLoginCookie]} then {
      error "missing or invalid login cookie"
    }

    #
    # NOTE: Build the full URI for the logout request, performing any
    #       applicable substitutions in the URI prior to using it as
    #       the basis for logging out of the repository.
    #
    set authToken [lindex $loginCookie 1]
    set uri [subst $logoutUri]

    #
    # NOTE: Reset the old login cookie, if any.  Then, issue a new login
    #       request, capturing the raw response data.
    #
    set data [getPackageFile $uri]

    #
    # NOTE: Attempt to extract the necessary values from the raw response
    #       data.
    #
    set pattern(1) {"name":"nobody"}; # TODO: *HACK* Keep updated.

    if {![regexp -- $pattern(1) $data dummy]} then {
      error "logout response missing \"name\""
    }

    #
    # NOTE: Reset the login cookie.
    #
    set loginCookie [list]

    #
    # NOTE: Always return an empty string (i.e. and not any response data).
    #
    return ""
  }

  #
  # NOTE: This procedure returns a unique temporary directory where one or
  #       more files may be saved.  The prefix argument is a prefix for the
  #       directory name and it may be an empty string.  There is no attempt
  #       to actually create the resulting directory.
  #
  proc getUniqueTempDirectory { {prefix ""} } {
    # <help>
    # This procedure computes a unique temporary directory name (under the
    # configured temporary root) into which downloaded files may be written.
    # It exists so that each download operation can stage its files in a
    # private, collision-free location before optionally persisting them.
    #
    # How it works: it obtains a unique suffix from the package repository
    # helper [getUniqueSuffix] and joins it with the temporary root directory,
    # optionally prefixing the leaf name with the caller's prefix.  When the
    # verbose-temporary-directory flag is enabled it logs the chosen name.  It
    # does NOT create the directory; it only returns the name.
    #
    # Tricky/security details: because the directory is not created here, there
    # is a window between name generation and use.  The toolset assumes the
    # temporary root is writable only by trusted applications (see the warning
    # on [maybeAddTemporaryPackagesToAutoPath]); on systems where the temporary
    # area is world-writable this staging area could be a target for tampering.
    # The well-known prefixes (such as the library and version prefixes used by
    # callers) are relied upon by the temporary-package auto-path scanner.
    #
    # Arguments:
    #   prefix -- Optional leaf-name prefix for the directory; defaults to the
    #             empty string, in which case only the unique suffix is used.
    #
    # Results:
    #   The fully qualified, not-yet-created unique temporary directory name.
    # </help>

    variable temporaryRootDirectory
    variable verboseTemporaryDirectory

    set suffix [::PackageRepository::getUniqueSuffix]

    if {[string length $prefix] > 0} then {
      set result [file join $temporaryRootDirectory \
          [appendArgs $prefix $suffix]]
    } else {
      set result [file join $temporaryRootDirectory \
          $suffix]
    }

    if {$verboseTemporaryDirectory} then {
      pkgLog [appendArgs \
          "returning temporary directory name \"" $result \
          "\" for prefix \"" $prefix \"...]
    }

    return $result
  }

  #
  # NOTE: This procedure creates a new interpreter, which may be "safe", and
  #       places a reference to it in a variable in the context of the caller
  #       identified by the varName argument.  The created interpreter has a
  #       fully functioning [package] command ensemble; all other commands do
  #       nothing and return nothing.  This procedure may raise script errors.
  #
  proc createInterp { varName } {
    # <help>
    # This procedure creates a heavily locked-down child interpreter in which
    # the only meaningful command is the package ensemble, and places a
    # reference to it in a caller variable.  It exists so that an untrusted
    # package index file can be sourced merely to discover which packages and
    # versions it would register, without allowing that file to actually do
    # anything else.
    #
    # How it works: it links the caller variable via [upvar], then creates a
    # safe interpreter and sets its global "dir" variable to a single period
    # (the one variable a package index file typically relies upon).  It
    # deletes all child namespaces, then turns every global command except
    # [proc] and [package] into a no-op (by redefining each as an empty
    # procedure).  Under native Tcl it also stubs out [file] as a no-op, since
    # safe Tcl interpreters lack it entirely even though index files may call
    # file join or file split.  Finally it neuters [proc] itself last (since it
    # was the tool used to neuter the others).  The reference is returned
    # through the caller variable, not as the result.
    #
    # Tricky/security details: this is a defense-in-depth sandbox for
    # evaluating index files.  Because nearly every command is a no-op, any
    # [set] of additional variables in the index file fails (set is a no-op),
    # so index files relying on variables other than "dir" will not work here.
    # The order of disabling matters: [proc] must be disabled last.  Even so,
    # this relies on the safety properties of the underlying safe interpreter;
    # it reduces, but the caller should still treat sourced index files as
    # untrusted input.
    #
    # Arguments:
    #   varName -- The name of a caller variable that receives the created
    #              interpreter reference.
    #
    # Results:
    #   An empty string (the interpreter is delivered through the caller
    #   variable).  A script error may be raised if interpreter creation or
    #   setup fails.
    # </help>

    #
    # NOTE: Prepare to provide the caller with the newly created interpreter
    #       reference.
    #
    upvar 1 $varName interp

    #
    # NOTE: Create a "safe" interpreter and set the global "dir" variable to
    #       a single period.  Generally, this is the only variable used by a
    #       package index file.  It should be noted that since [set] will be
    #       a NOP, attempts to use other variables in the specified package
    #       index file (e.g. ones [set] within it) will fail.
    #
    set interp [interp create -safe]
    interp eval $interp [list set dir .]

    #
    # NOTE: First, obtain the list of child namespaces to delete, if any, and
    #       then delete them all.  This should leave the global namespace and
    #       its commands / variables untouched.
    #
    set namespaces [interp eval $interp [list namespace children ::]]

    foreach namespace $namespaces {
      catch {
        interp eval $interp [list namespace delete $namespace]
      }
    }

    #
    # NOTE: Next, obtain the list of global commands and delete all of them
    #       except the [proc] and [package] commands.  The [proc] command is
    #       handled specially (last) and the [package] command is retained.
    #
    set commands [interp eval $interp [list info commands]]

    foreach command $commands {
      if {$command ne "proc" && $command ne "package"} then {
        interp eval $interp [list proc $command args ""]; # NOP
      }
    }

    if {![isEagle]} then {
      #
      # HACK: The "safe" interpreters in native Tcl do not contain
      #       the [file] command at all, not even for [file join]
      #       and [file split], which may be used in package index
      #       files; therefore, add it as a NOP command.
      #
      interp eval $interp [list proc file args ""]; # NOP
    }

    #
    # NOTE: Next, disable the [proc] command.  This must be done last
    #       because it is used to disable (i.e. via NOP) all the other
    #       global commands.
    #
    interp eval $interp [list proc proc args ""]; # NOP

    #
    # NOTE: Finally, return nothing as the created interpreter reference
    #       is placed directly into the variable specified by the caller.
    #
    return ""
  }

  #
  # NOTE: This procedure evaluates a script file and attempts to determine the
  #       list of new [package ifneeded] scripts added by it.  When successful
  #       it returns a list-of-lists.  Each element of the outer list contains
  #       a package name and the list of its versions in descending order; in
  #       the event of failure, empty lists may be returned for the outer list
  #       or for a list of versions.  The interp argument is the interp to use
  #       when evaluating the file specified by the fileName argument.  This
  #       procedure may raise script errors.
  #
  proc getIfNeededVersions { interp fileName } {
    # <help>
    # This procedure sources a package index file inside a given (sandboxed)
    # interpreter and reports the packages it newly registers, along with their
    # available versions.  It exists to discover the package-and-version
    # information contained in a downloaded index file without trusting or
    # executing that file in the real interpreter.
    #
    # How it works: it records the set of package names already known to the
    # interpreter, sources the index file via [interp invokehidden] using the
    # hidden source command (which runs the index file's [package ifneeded]
    # registrations), and then collects the package names that are new.  For
    # each new package it gathers the registered versions and sorts them in
    # descending order using [package vcompare].  The result is a list of
    # two-element entries, each pairing a package name with its
    # descending-ordered version list.
    #
    # Tricky/security details: this is meant to be used with the locked-down
    # interpreter produced by [createInterp]; sourcing an index file there is
    # how untrusted index files are inspected safely.  It uses the hidden
    # source command precisely because, in a safe interpreter, source is hidden
    # rather than exposed.  Only newly added packages are reported, so packages
    # already present before the source are ignored.
    #
    # Arguments:
    #   interp   -- The interpreter (typically a sandbox from [createInterp]) in
    #               which to source the file.
    #   fileName -- The package index file to source.
    #
    # Results:
    #   A list of two-element entries, each containing a package name and its
    #   versions in descending order.  Empty lists may result when nothing new
    #   is registered.  A script error may be raised if sourcing fails.
    # </help>

    set result [list]

    set oldPackageNames [interp eval $interp [list package names]]
    interp invokehidden $interp source $fileName; # [package ifneeded], etc.
    set newPackageNames [interp eval $interp [list package names]]

    foreach packageName $newPackageNames {
      if {[lsearch -exact $oldPackageNames $packageName] == -1} then {
        lappend result [list $packageName [lsort -decreasing \
            -command [list package vcompare] [interp eval \
            $interp [list package versions $packageName]]]]
      }
    }

    return $result
  }

  #
  # NOTE: This procedure attempts to extract a package version information
  #       from the specified file.  The fileName argument is the local file
  #       name to read.  This procedure may raise script errors.
  #
  proc extractVersionsFromFile { fileName } {
    # <help>
    # This procedure extracts package version information from a local file,
    # supporting both plain VERSION files and package index files.  It exists
    # so that the higher-version check can compare the version offered by the
    # server against the version already installed locally, regardless of which
    # form the version information takes.
    #
    # How it works: it switches on the file's leaf name.  A file named VERSION
    # is read and its trimmed contents are returned as a single-element list.
    # A file named pkgIndex.eagle or pkgIndex.tcl is evaluated in a freshly
    # created sandbox interpreter (via [createInterp]) and its newly registered
    # versions are obtained via [getIfNeededVersions]; if the sandbox cannot be
    # created the failure is logged and an empty list is used.  The sandbox
    # interpreter is always deleted afterward.
    #
    # Tricky/security details: index-file handling deliberately runs inside the
    # locked-down sandbox so that an untrusted downloaded index file cannot do
    # harm while its version data is read.  The sandbox interpreter is cleaned
    # up in all cases.  For file names that are neither VERSION nor a known
    # index file, the [switch] has no matching branch, so the procedure returns
    # the empty string (callers commonly index element zero of the result, so
    # they should tolerate an empty result).
    #
    # Arguments:
    #   fileName -- The local file to extract version information from; behavior
    #               depends on its leaf name as described above.
    #
    # Results:
    #   For a VERSION file, a single-element list with the version string.  For
    #   an index file, the list-of-entries produced by [getIfNeededVersions]
    #   (possibly empty).  For other names, the empty string.  A script error
    #   may be raised while reading or evaluating.
    # </help>

    switch -exact -- [file tail $fileName] {
      VERSION {
        return [list [string trim [readFile $fileName]]]
      }
      pkgIndex.eagle -
      pkgIndex.tcl {
        #
        # TODO: Evaluate the package index file in a new "safe"
        #       interpreter and obtain the newly added [package
        #       ifneeded] version(s)?
        #
        if {[catch {createInterp interp} error] == 0} then {
          set result [getIfNeededVersions $interp $fileName]
        } else {
          pkgLog [appendArgs \
              "could not create interp to extract versions: " \
              $error]

          set result [list]
        }

        if {[info exists interp]} then {
          catch {interp delete $interp}
          unset interp; # REDUNDANT
        }

        return $result
      }
    }
  }

  #
  # NOTE: This procedure checks if there is a higher version available of the
  #       specified package on the package file server.  The language argument
  #       must be one of the literal strings "eagle", "tcl", or "client".  The
  #       version argument must be one of the literal strings "8.4", "8.5", or
  #       "8.6" when the language is "tcl" -OR- the literal string "1.0" when
  #       the language is either "eagle" or "client".  The platform argument
  #       must be an empty string -OR- one of the literal strings "msil" or
  #       "neutral", or one of the values returned by the [getPlatform]
  #       procedure.  An empty string means that the associated package does
  #       not require a specific platform.  The packageName argument is a
  #       directory name relative to the language and version-specific
  #       directory on the package file server and may be an empty string.
  #       The usePgp argument should be non-zero when an OpenPGP signature
  #       file needs to be downloaded and verified for the downloaded file.
  #
  # <public>
  proc checkForHigherVersion { language version platform packageName usePgp } {
    # <help>
    # This procedure determines whether the package file server offers a higher
    # version of a package than the one currently installed locally.  It exists
    # to drive update decisions -- callers use it to learn whether downloading
    # a newer version is warranted.
    #
    # How it works: it validates the package name, language/version (learning
    # whether this is the client itself), and platform.  It creates a unique
    # temporary directory and, depending on whether the target is the client or
    # an ordinary package, selects either the client directory or the verified
    # persistent root as the local comparison base.  It then tries, in order, a
    # set of candidate version-bearing files (VERSION, then the Eagle and Tcl
    # package index files).  For the first candidate that downloads
    # successfully via [downloadOneFile], it optionally also downloads the
    # corresponding ".asc" OpenPGP signature (when usePgp is set), compares the
    # downloaded version against the local file's version using [package
    # vcompare], cleans up the temporary directory, and returns whether the
    # remote version is strictly higher.  If none of the candidate files can be
    # downloaded, it raises an error.
    #
    # Tricky/security details: when usePgp is true the downloaded version file
    # is accompanied by its OpenPGP signature so that [downloadOneFile] can
    # verify it; with usePgp false no signature verification occurs and the
    # comparison rests on unverified data.  Version extraction for index files
    # is performed in a sandbox (see [extractVersionsFromFile]), so untrusted
    # index content is not executed in the real interpreter.  The temporary
    # directory is removed before returning on the success path (note: on the
    # error path it may be left behind).  Platform may be auto-detected, which
    # itself performs a network download (see [verifyPlatform]).
    #
    # Arguments:
    #   language    -- "eagle", "tcl", or "client" (empty string treated as
    #                  Eagle).
    #   version     -- The version allowed for the language (see
    #                  [verifyLanguageAndVersion]).
    #   platform    -- The platform, or empty string to auto-detect.
    #   packageName -- The package's directory name relative to the
    #                  language/version directory; may be empty.
    #   usePgp      -- Boolean; when non-zero, download and verify the OpenPGP
    #                  signature for the version file.
    #
    # Results:
    #   Non-zero (true) if a strictly higher version is available remotely;
    #   otherwise zero (false).  A script error is raised on validation
    #   failure, signature failure, or when no supported version file can be
    #   downloaded.
    # </help>

    variable clientDirectory
    variable persistentRootDirectory

    verifyPackageName $packageName
    verifyLanguageAndVersion $language $version isClient
    verifyPlatform $platform platform

    set temporaryDirectory [getUniqueTempDirectory pkgd_ver_]

    if {$isClient} then {
      set persistentDirectory $clientDirectory
    } else {
      verifyPersistentRootDirectory
      set persistentDirectory $persistentRootDirectory
    }

    set fileNamesOnly [list VERSION pkgIndex.eagle pkgIndex.tcl]

    foreach fileNameOnly $fileNamesOnly {
      set fileName [file join $packageName $fileNameOnly]
      set downloadFileName [file join $temporaryDirectory $fileName]

      file mkdir [file dirname $downloadFileName]

      if {[catch {
        downloadOneFile $language $version $platform \
            $fileName $downloadFileName $usePgp
      }] == 0} then {
        if {$usePgp} then {
          downloadOneFile $language $version $platform \
              [appendArgs $fileName .asc] \
              [appendArgs $downloadFileName .asc] $usePgp
        }

        set localFileName [file join $persistentDirectory $fileName]

        set compare [package vcompare \
            [lindex [extractVersionsFromFile $downloadFileName] 0] \
            [lindex [extractVersionsFromFile $localFileName] 0]]

        if {[isEagle]} then {
          file delete -recursive -- $temporaryDirectory
        } else {
          file delete -force -- $temporaryDirectory
        }

        return [expr {$compare > 0}]
      }
    }

    error "could not check higher version: no supported file names"
  }

  #
  # NOTE: This procedure attempts to guess a package name based on a list of
  #       its files.  It relies upon the fact that all packages must include
  #       a package index file.  The language argument must be one of the
  #       literal strings "eagle", "tcl", or "client".  The fileNames argument
  #       must be the list of file names to be downloaded.  The package name,
  #       if one can be detected, is returned; otherwise, an empty string will
  #       be returned.
  #
  proc guessPackageNameFromFileNames { language fileNames } {
    # <help>
    # This procedure infers a package name from a list of the package's file
    # names.  It exists for the common case where a caller knows the files to
    # download but not the package directory name; since every package must
    # contain a package index file, the directory holding that index reveals
    # the package name.
    #
    # How it works: it determines the index file name for the language via
    # [getPackageIndexFileName].  If the language supports one, it scans the
    # provided file names for one whose leaf name equals the index file name;
    # the leaf name of that file's containing directory is returned as the
    # package name.
    #
    # Tricky details: this relies on the convention that the package index file
    # sits directly in the package's directory.  If no file matches the index
    # name (or the language has no index file), the empty string is returned to
    # signal "could not determine".
    #
    # Arguments:
    #   language  -- "eagle", "tcl", or "client" (empty string treated as
    #                Eagle); selects the index file name to look for.
    #   fileNames -- The list of file names to inspect.
    #
    # Results:
    #   The guessed package name, or the empty string if it cannot be
    #   determined.
    # </help>

    set packageIndexFileNameOnly [getPackageIndexFileName $language]

    if {[string length $packageIndexFileNameOnly] > 0} then {
      foreach fileName $fileNames {
        set fileNameOnly [file tail $fileName]

        if {$fileNameOnly eq $packageIndexFileNameOnly} then {
          set directory [file dirname $fileName]

          if {[string length $directory] > 0} then {
            return [file tail $directory]
          }
        }
      }
    }

    return ""
  }

  #
  # NOTE: This procedure downloads a manitest from the package file server,
  #       writing its contents to the specified local file name.  It can also
  #       verify the OpenPGP signature.  The language argument must be one of
  #       the literal strings "eagle", "tcl", or "client".  The version
  #       argument must be one of the literal strings "8.4", "8.5", or "8.6"
  #       when the language is "tcl" -OR- the literal string "1.0" when the
  #       language is either "eagle" or "client".  The packageName argument
  #       is a directory name relative to the language and version-specific
  #       directory on the package file server and may be an empty string.
  #       The fileNames argument is the list of file names to be downloaded.
  #       The usePgp argument should be non-zero when an OpenPGP signature
  #       needs to be verified for the downloaded file.
  #
  proc downloadAllPlatforms { language version packageName fileNames usePgp } {
    # <help>
    # This procedure downloads the server manifest and returns the set of
    # platforms for which the specified package is available.  It exists to
    # support automatic platform selection (see [verifyPlatform]) by revealing
    # which platform-specific directories actually exist for a package on the
    # server.
    #
    # How it works: it validates the package name and language/version, stages
    # a temporary directory, and downloads the manifest from the configured
    # platforms URI (after expanding the URI template via [subst]) into a local
    # file -- crucially calling [downloadOneUriToFile] with the force-PGP flag
    # set true, because all manifests on the server are expected to be OpenPGP
    # signed.  It then reads the verified manifest, splits it into lines, and
    # builds a glob pattern from the language, version, and (possibly guessed)
    # package name; client files and ordinary package files use different path
    # layouts, so the pattern and the path-component index differ accordingly.
    # For each manifest line beginning with the file marker that matches the
    # pattern, it extracts the platform directory component and accumulates the
    # distinct values.  The temporary directory is removed and a sorted, unique
    # platform list is returned.
    #
    # Tricky/security details: the manifest download forces OpenPGP
    # verification (forcePgp true) regardless of the usePgp argument's effect
    # elsewhere, so the platform list is derived from signed, verified data --
    # an important integrity property, since platform selection ultimately
    # influences which binaries get fetched.  Note, however, that verification
    # still only happens when usePgp is also honored by the underlying download
    # path; callers wanting verified platform data should pass usePgp true.
    # When the package name is empty it is guessed from the file names via
    # [guessPackageNameFromFileNames], which widens or narrows the match.  The
    # manifest is parsed line-by-line using Fossil's textual manifest format.
    #
    # Arguments:
    #   language    -- "eagle", "tcl", or "client" (empty string treated as
    #                  Eagle).
    #   version     -- The version allowed for the language.
    #   packageName -- The package directory name; may be empty (then guessed).
    #   fileNames   -- The list of file names, used to guess the package name
    #                  when it is empty.
    #   usePgp      -- Boolean controlling whether the OpenPGP verification of
    #                  the manifest download is actually performed.
    #
    # Results:
    #   A sorted, de-duplicated list of platform names available for the
    #   package.  A script error is raised on validation failure, download
    #   failure, or signature failure.
    # </help>

    variable baseUri
    variable branchName
    variable platformsUri
    variable platformsUrn

    #
    # NOTE: Verify that the package name, language, and version are correct.
    #
    verifyPackageName $packageName
    verifyLanguageAndVersion $language $version isClient

    set temporaryDirectory [getUniqueTempDirectory pkgd_plat_]

    set localFileName [file join $temporaryDirectory manifest.txt]
    file mkdir [file dirname $localFileName]

    #
    # NOTE: First, build the final URI to download from the remote package
    #       repository, performing any applicable substitutions in the URI
    #       prior to using it as the basis for fetching the platform list.
    #
    set uri [subst $platformsUri]

    #
    # NOTE: Then, in one step, download the file from the package file
    #       server and write it to the specified local file.  Also, make
    #       sure it has a valid OpenPGP signature because all manifests on
    #       the server should be signed.
    #
    downloadOneUriToFile $localFileName $uri $usePgp true

    #
    # NOTE: Initialize list of platforms to return.  This will be populated
    #       based on the platform directories available in the downloaded
    #       manfiest data.
    #
    set platforms [list]

    #
    # NOTE: Read the (OpenPGP verified) manifest data from the local file
    #       and split it into lines.
    #
    set data [readFile $localFileName]; set lines [split $data \n]

    #
    # NOTE: Figure out the pattern to use when matching against the file
    #       names in the manifest data.  If available, this will include
    #       the package name; otherwise, platform names for all packages
    #       will be considered.
    #
    if {[string length $packageName] == 0} then {
      set packageName [guessPackageNameFromFileNames $language $fileNames]
    }

    if {[string length $packageName] > 0} then {
      set pattern [file join $language $version * $packageName *]
    } else {
      set pattern [file join $language $version *]
    }

    #
    # NOTE: For package files that are not part of the client package,
    #       put them inside the "packages" sub-directory.
    #
    if {$isClient} then {
      set index 2; # client/1.0/<neutral>/fileName.ext
    } else {
      set pattern [file join packages $pattern]
      set index 3; # packages/tcl/8.4/<neutral>/pkgName1.0/fileName.ext
    }

    foreach line $lines {
      if {[string range $line 0 1] eq "F "} then {
        set fileName [lindex [split $line " "] 1]

        if {[string match $pattern $fileName]} then {
          set directory [lindex [file split $fileName] $index]

          if {[string length $directory] > 0 && \
              [lsearch -exact $platforms $directory] == -1} then {
            lappend platforms $directory
          }
        }
      }
    }

    if {[isEagle]} then {
      file delete -recursive -- $temporaryDirectory
    } else {
      file delete -force -- $temporaryDirectory
    }

    return [lsort -unique $platforms]
  }

  #
  # NOTE: This procedure downloads a single URI from the package file server
  #       and writes the result to a local file.  The localFileName argument
  #       is the file name where the downloaded file should be written.  The
  #       The uri argument is the URI to download.  The usePgp argument should
  #       be non-zero when the OpenPGP signature file needs to be verified for
  #       the downloaded file.  The return value is undefined.
  #
  proc downloadOneUriToFile { localFileName uri usePgp forcePgp } {
    # <help>
    # This procedure downloads a single URI from the package file server,
    # writes the response to a local file, and optionally verifies its OpenPGP
    # signature.  It is the common building block beneath the higher-level
    # download procedures, pairing the transport step with the (optional)
    # integrity step in one place.
    #
    # How it works: it fetches the URI's contents with [getPackageFile] and
    # writes them to the local file with [writeFile].  Then, if usePgp is true,
    # it calls [maybeVerifyOpenPgpSignature] on the written file, passing along
    # forcePgp.  That helper verifies when forcePgp is true or when the file
    # appears (by name) to be a signature file, and raises an error on a bad or
    # unverifiable signature.
    #
    # Tricky/security details: this is the seam where transport and trust meet.
    # The file is written to disk before verification; if verification later
    # fails the error propagates, but the (untrusted) file has already been
    # written, so callers must treat a failed call as having produced a
    # possibly-bad file and not consume it.  Verification is entirely opt-in via
    # usePgp -- with usePgp false the downloaded content is accepted without any
    # signature check, resting solely on transport security.  The forcePgp flag
    # is how a caller demands verification of a file that would not be
    # recognized as a signature by name alone (used, for example, for signed
    # manifests).
    #
    # Arguments:
    #   localFileName -- The local file name to write the downloaded data to.
    #   uri           -- The fully qualified package file server URI to fetch.
    #   usePgp        -- Boolean; when non-zero, perform OpenPGP verification of
    #                    the downloaded file.
    #   forcePgp      -- Boolean; when non-zero, verify even if the file does
    #                    not look (by name) like a signature file.  Only
    #                    consulted when usePgp is non-zero.
    #
    # Results:
    #   The result is unspecified on success.  A script error is raised on
    #   download failure, write failure, or signature verification failure.
    # </help>

    #
    # NOTE: Then, in one step, download the URI from the package file
    #       server and write it to the specified local file.
    #
    writeFile $localFileName [getPackageFile $uri]

    #
    # NOTE: Is use of OpenPGP for signature verification enabled?  Also,
    #       did we just download an OpenPGP signature file?
    #
    if {$usePgp} then {
      #
      # NOTE: Maybe attempt to verify the OpenPGP signature.  If this
      #       fails, an error is raised.
      #
      maybeVerifyOpenPgpSignature $localFileName $forcePgp
    }
  }

  #
  # NOTE: This procedure downloads a single file from the package file server,
  #       writing its contents to the specified local file name.  It can also
  #       verify the OpenPGP signatures.  When an OpenPGP signature file is
  #       downloaded, this procedure assumes the corresponding data file was
  #       already downloaded (i.e. since OpenPGP needs both to perform the
  #       signature checks).  The language argument must be one of the
  #       literal strings "eagle", "tcl", or "client".  The version argument
  #       must be one of the literal strings "8.4", "8.5", or "8.6" when the
  #       language is "tcl" -OR- the literal string "1.0" when the language
  #       is either "eagle" or "client".  The platform argument must be an
  #       empty string -OR- one of the literal strings "msil" or "neutral", or
  #       one of the values returned by the [getPlatform] procedure.  An empty
  #       string means that the associated package does not require a specific
  #       platform.  The fileName argument is a file name relative to the
  #       language and version-specific directory on the package file server.
  #       The localFileName argument is the file name where the downloaded
  #       file should be written.  The usePgp argument should be non-zero when
  #       the OpenPGP signature file needs to be verified for the downloaded
  #       file.
  #
  proc downloadOneFile {
          language version platform fileName localFileName usePgp } {
    # <help>
    # This procedure downloads a single named package file from the package
    # file server to a local file, building the correct server-relative path
    # from the language, version, and platform, and optionally verifying its
    # OpenPGP signature.  It is the per-file download primitive used by the
    # version check and the multi-file download driver.
    #
    # How it works: it validates the language/version (learning whether this is
    # the client) and the platform, then composes the server-relative file name
    # by joining the language, version, platform, and the given relative file
    # name.  For files that are not part of the client package it additionally
    # nests them under the "packages" subdirectory.  It expands the download
    # URI template via [subst] (interpolating and escaping the file name) and
    # then delegates to [downloadOneUriToFile] to fetch the URI, write the
    # local file, and optionally verify.  Note it passes forcePgp false, so
    # signature verification of a data file happens only when the file itself
    # is recognized as a signature file.
    #
    # Tricky/security details: when an OpenPGP signature file (".asc") is being
    # downloaded, the corresponding data file is assumed to have already been
    # downloaded, since OpenPGP needs both files present to verify.  The
    # client-versus-package distinction governs the on-server path layout and
    # therefore which file is fetched; misclassification would target the wrong
    # path.  As always, with usePgp false no verification occurs.
    #
    # Arguments:
    #   language      -- "eagle", "tcl", or "client" (empty string treated as
    #                    Eagle).
    #   version       -- The version allowed for the language.
    #   platform      -- The platform, or empty string to auto-detect (which
    #                    triggers a network query; see [verifyPlatform]).
    #   fileName      -- The file name relative to the language/version
    #                    directory on the server.
    #   localFileName -- The local file name to write the downloaded data to.
    #   usePgp        -- Boolean; when non-zero, verify the OpenPGP signature of
    #                    the downloaded file (only effective when the file is a
    #                    signature file, since forcePgp is false here).
    #
    # Results:
    #   The result is the value of the underlying [downloadOneUriToFile] call
    #   (unspecified; invoked for effect).  A script error is raised on
    #   validation, download, or signature failure.
    # </help>

    variable baseUri
    variable branchName
    variable downloadUri
    variable downloadUrn

    #
    # NOTE: Verify that the package language, version, and platform are
    #       correct.
    #
    verifyLanguageAndVersion $language $version isClient
    verifyPlatform $platform platform

    #
    # NOTE: First, build the full relative file name to download from
    #       the remote package repository.
    #
    set fileName [file join $language $version $platform $fileName]

    #
    # NOTE: For package files that are not part of the client package,
    #       put them inside the "packages" sub-directory.
    #
    if {!$isClient} then {
      set fileName [file join packages $fileName]
    }

    #
    # NOTE: Perform any applicable substitutions in the URI prior to
    #       using it as the basis for downloading the package file.
    #
    set uri [subst $downloadUri]

    #
    # NOTE: Then, in one step, download the file from the package file
    #       server and write it to the specified local file.
    #
    downloadOneUriToFile $localFileName $uri $usePgp false
  }

  #
  # NOTE: This procedure attempts to download a list of files, optionally
  #       persisting them for subsequent uses by the target language.
  #       The language argument must be one of the literal strings "eagle",
  #       "tcl", or "client".  The version argument must be one of the
  #       literal strings "8.4", "8.5", or "8.6" when the language is "tcl"
  #       -OR- the literal string "1.0" when the language is either "eagle"
  #       or "client".  The platform argument must be an empty string -OR-
  #       one of the literal strings "msil" or "neutral", or one of the values
  #       returned by the [getPlatform] procedure.  An empty string means
  #       that the associated package does not require a specific platform.
  #       The fileNames argument must be a well-formed list of file names to
  #       download, each one relative to the language and version-specific
  #       directory on the package file server.  The options argument must
  #       be a dictionary of name/value pairs.  The -persistent option should
  #       be non-zero if the downloaded files should be saved to permanent
  #       storage for subsequent use.  The -usePgp option should be non-zero
  #       when an OpenPGP signature file needs to be downloaded and verified
  #       for each downloaded file.  The -useAutoPath option should be
  #       non-zero to modify the auto-path to include the temporary or
  #       persistent directories containing the downloaded files.  The
  #       -allowUpdate option should be non-zero to allow existing package
  #       files to be overwritten.
  #
  # <public>
  proc downloadFiles { language version platform fileNames options } {
    # <help>
    # This procedure is the main public entry point for downloading a set of
    # package files, optionally verifying them, persisting them to permanent
    # storage, and wiring the resulting directories into the auto-path.  It
    # exists to perform a complete, policy-driven package install/download in a
    # single call, and it ties together nearly every other procedure in the
    # toolset.
    #
    # How it works: it reads boolean options from the supplied options
    # dictionary -- whether to persist files (-persistent), overwrite existing
    # persistent files (-overwrite), verify OpenPGP signatures (-usePgp),
    # modify the auto-path (-useAutoPath), and allow updates of existing files
    # (-allowUpdate).  It validates the language/version (learning whether this
    # is the client) and the platform, and stages a unique temporary directory.
    # For each requested file it insists the name be relative with directory
    # parts (erroring otherwise), computes the temporary and persistent target
    # directories, refuses to clobber an already-staged temporary file, and --
    # when persisting and not overwriting -- skips files that already exist in
    # the persistent location.  It downloads each file via [downloadOneFile]
    # and, when verification is requested and the file is not itself a
    # signature, also downloads the matching ".asc" signature so verification
    # can occur.  It then copies staged files into their persistent locations
    # (using a forced overwrite for client files or when updates are allowed),
    # removes the temporary tree, and for native Tcl maybe creates the root
    # package index.  Finally, when -useAutoPath is set, it adds the relevant
    # directories (the persistent root for the Tcl root-index case, or each
    # download directory that actually contains a package index file) to the
    # language's auto-path, and returns the list of directories used.
    #
    # Tricky/security details: this procedure can write into and execute from
    # the persistent library path, so it is the most security-sensitive in the
    # toolset.  Signature verification is only performed when -usePgp is set;
    # without it, files are downloaded and persisted with no integrity check
    # beyond transport security.  Persistence is forced not only by -persistent
    # but also implicitly when the client is running under the installer tool
    # (the viaInstall flag).  Client files are always copied with forced
    # overwrite (to allow self-update), and -allowUpdate extends forced
    # overwrite to ordinary packages -- so an attacker who can influence what
    # is downloaded could, with these options, replace installed files.  Adding
    # a directory to the auto-path makes its packages auto-loadable, so only
    # trusted content should ever reach this stage.  Relative-path enforcement
    # on each file name is a guard against escaping the intended directories.
    #
    # Arguments:
    #   language  -- "eagle", "tcl", or "client" (empty string treated as
    #                Eagle).
    #   version   -- The version allowed for the language.
    #   platform  -- The platform, or empty string to auto-detect (which
    #                performs a network query; see [verifyPlatform]).
    #   fileNames -- A well-formed list of relative file names to download,
    #                each relative to the language/version directory on the
    #                server.
    #   options   -- A dictionary of name/value options: -persistent,
    #                -overwrite, -usePgp, -useAutoPath, and -allowUpdate, each
    #                interpreted as a boolean.  Unrecognized options are
    #                ignored.
    #
    # Results:
    #   The list of directories that were used for the downloaded files (the
    #   persistent directories when persisting, otherwise the temporary
    #   directories), de-duplicated; this is also the set considered for the
    #   auto-path.  A script error is raised on bad file names, validation
    #   failure, an existing temporary file, download failure, or signature
    #   failure.
    # </help>

    variable clientDirectory
    variable persistentRootDirectory
    variable viaInstall

    set persistent [string is true -strict \
        [getDictionaryValue $options -persistent]]

    set overwrite [string is true -strict \
        [getDictionaryValue $options -overwrite]]

    set usePgp [string is true -strict \
        [getDictionaryValue $options -usePgp]]

    set useAutoPath [string is true -strict \
        [getDictionaryValue $options -useAutoPath]]

    set allowUpdate [string is true -strict \
        [getDictionaryValue $options -allowUpdate]]

    #
    # NOTE: Verify that the package language, version, and platform are
    #       correct.
    #
    verifyLanguageAndVersion $language $version isClient
    verifyPlatform $platform platform

    set temporaryDirectory [getUniqueTempDirectory pkgd_lib_]

    if {$isClient} then {
      set persistentDirectory $clientDirectory
    } else {
      verifyPersistentRootDirectory
      set persistentDirectory $persistentRootDirectory
    }

    set downloadedFileNames [list]

    foreach fileName $fileNames {
      if {[string length $fileName] == 0 || \
          [file pathtype $fileName] ne "relative"} then {
        error [appendArgs \
            "bad file name \"" $fileName "\", not relative"]
      }

      set directoryParts [file split [file dirname $fileName]]

      if {[llength $directoryParts] == 0} then {
        error [appendArgs \
            "bad file name \"" $fileName "\", no directory parts"]
      }

      set directory(temporary) [file normalize [eval \
          file join [list $temporaryDirectory] $directoryParts]]

      set directory(persistent) [file normalize [eval \
          file join [list $persistentDirectory] $directoryParts]]

      set fileNameOnly [file tail $fileName]

      set downloadFileName [file normalize [file join \
          $directory(temporary) $fileNameOnly]]

      if {[file exists $downloadFileName]} then {
        error [appendArgs \
            "temporary file name \"" $downloadFileName \
            "\" already exists"]
      }

      if {$persistent || $viaInstall} then {
        if {!$overwrite} then {
          set persistentFileName [file normalize [file join \
              $directory(persistent) $fileNameOnly]]

          if {[file exists $persistentFileName]} then {
            continue
          }
        }
      }

      file mkdir [file dirname $downloadFileName]

      downloadOneFile $language $version $platform \
          $fileName $downloadFileName $usePgp

      lappend downloadedFileNames [list \
          $fileNameOnly $directory(temporary) $directory(persistent)]

      if {$usePgp && \
          ![isOpenPgpSignatureFileName $downloadFileName true]} then {
        downloadOneFile $language $version $platform \
            [appendArgs $fileName .asc] \
            [appendArgs $downloadFileName .asc] $usePgp

        lappend downloadedFileNames [list \
            [appendArgs $fileNameOnly .asc] $directory(temporary) \
            $directory(persistent)]
      }
    }

    set downloadDirectories [list]

    foreach downloadedFileName $downloadedFileNames {
      set directory(temporary) [lindex $downloadedFileName 1]

      if {$persistent || $viaInstall} then {
        set fileNameOnly [lindex $downloadedFileName 0]
        set directory(persistent) [lindex $downloadedFileName 2]

        file mkdir $directory(persistent)
        set command [list file copy]

        #
        # NOTE: When updating the package repository client files, always
        #       use the -force option to overwrite existing files.  Also,
        #       if we are allow updates, use the -force option.
        #
        if {$isClient || $allowUpdate} then {
          lappend command -force
        }

        lappend command --
        lappend command [file join $directory(temporary) $fileNameOnly]
        lappend command [file join $directory(persistent) $fileNameOnly]

        eval $command

        lappend downloadDirectories $directory(persistent)
      } else {
        lappend downloadDirectories $directory(temporary)
      }
    }

    #
    # NOTE: Does the package need to be persisted locally?  This can be set
    #       via the direct caller or via the installer tool.
    #
    set addPersistentDirectoryToAutoPath false

    if {$persistent || $viaInstall} then {
      #
      # NOTE: In Eagle, a slightly different command is required to delete
      #       an entire directory tree.
      #
      if {[isEagle]} then {
        file delete -recursive -- $temporaryDirectory
      } else {
        file delete -force -- $temporaryDirectory
      }

      #
      # NOTE: When the target language is native Tcl, try to create the
      #       "root" package index, if necessary.
      #
      if {$language eq "tcl"} then {
        maybeCreateRootTclPackageIndex
        set addPersistentDirectoryToAutoPath true
      }
    }

    #
    # NOTE: Sort the list of directories that downloaded files were written
    #       to, removing any duplicates in the process.
    #
    set downloadDirectories [lsort -unique $downloadDirectories]

    if {$useAutoPath} then {
      #
      # NOTE: The auto-path, for whatever language this package belongs to,
      #       needs to be modified.
      #
      if {$addPersistentDirectoryToAutoPath} then {
        #
        # NOTE: The downloaded package was persisted -AND- will be handled
        #       by the "root" package index; therefore, just make sure the
        #       package persistence root directory is in the auto-path and
        #       then return only that directory in the result.
        #
        maybeAddToAutoPath $language $persistentDirectory
        set downloadDirectories [list $persistentDirectory]
      } else {
        #
        # NOTE: Check each unique download directory for a package index
        #       file.  If a directory has a package index for the target
        #       language, add to the auto-path for the target language.
        #
        set packageIndexFileNameOnly [getPackageIndexFileName $language]

        if {[string length $packageIndexFileNameOnly] > 0} then {
          foreach downloadDirectory $downloadDirectories {
            if {[file exists [file join \
                $downloadDirectory $packageIndexFileNameOnly]]} then {
              addToAutoPath $language $downloadDirectory
            }
          }
        }
      }
    }

    #
    # NOTE: Always return the list of directories that were actually added
    #       to the auto-path, if any.
    #
    return $downloadDirectories
  }

  #
  # NOTE: This procedure adds temporary package directories to the auto-path
  #       of the specified language (i.e. native Tcl or Eagle).  Directories
  #       will not be added if already present.  The language argument must
  #       be the literal string "eagle" or the literal string "tcl".  The
  #       pattern argument is the optional pattern to match against each of
  #       the candidate temporary package directories.  If the pattern is an
  #       empty string then all candidate temporary package directories will
  #       be added to the auto-path; otherwise, the pattern will be matched
  #       against the final portion of the temporary package directory name
  #       and only those temporary package directories that actually match
  #       the pattern will be added to the auto-path.  The options argument
  #       must be a dictionary of name/value pairs.  This procedure does not
  #       currently support any options.  This procedure may raise script
  #       errors.  This procedure assumes the local temporary directory is
  #       writable only by applications that are implicitly trusted by the
  #       current user.  If this assumption does not hold on your platform,
  #       DO NOT USE THIS PROCEDURE AS IT MAY BE UNSAFE.
  #
  # <public>
  proc maybeAddTemporaryPackagesToAutoPath { language options {pattern ""} } {
    # <help>
    # This procedure scans the temporary download area for staged (not yet
    # persisted) package directories and adds the matching ones to the
    # auto-path of the given language.  It exists so that packages downloaded
    # only to temporary storage can still be made loadable for the current
    # session without persisting them.
    #
    # How it works: it determines the language's package index file name, then
    # globs the temporary root for the well-known per-download directories and,
    # within each, their immediate subdirectories (which are treated as
    # package directories whose leaf name is the package name).  For each
    # candidate not already handled, and matching the optional pattern against
    # the directory's leaf name, and containing the expected index file (when
    # the language has one), it calls [maybeAddToAutoPath]; directories
    # actually added are recorded (and optionally logged) and returned.  An
    # empty pattern matches all candidates.  The options dictionary is accepted
    # for forward compatibility but no options are currently supported.
    #
    # Tricky/SECURITY details: this is the most explicitly dangerous procedure
    # in the toolset.  It adds directories from the shared local temporary area
    # to the auto-path, from which their packages can be auto-loaded and
    # executed.  It is therefore SAFE ONLY IF the local temporary directory is
    # writable solely by applications the current user implicitly trusts.  On
    # any platform where the temporary area is world-writable (or otherwise
    # writable by untrusted processes), an attacker could plant a malicious
    # package there and have it loaded -- so, per the in-line warning, THIS
    # PROCEDURE MUST NOT BE USED in that situation.  The directory-name-derived
    # package names and the well-known temporary prefixes are conventions this
    # scan relies upon.
    #
    # Arguments:
    #   language -- "eagle" or "tcl"; selects the index file name and the
    #               target auto-path.
    #   options  -- A dictionary of name/value options; currently none are
    #               supported.
    #   pattern  -- Optional glob pattern matched against each candidate package
    #               directory's leaf name; the empty string (default) matches
    #               all candidates.
    #
    # Results:
    #   The list of temporary package directories that were actually added to
    #   the auto-path (possibly empty).  A script error may be raised.
    # </help>

    variable temporaryRootDirectory
    variable verboseTemporaryDirectory

    #
    # NOTE: Initially, no temporary package directories have been added
    #       to the auto-path.
    #
    set result [list]; set packageNames [list]

    #
    # NOTE: What is the package index file name for this language?  Each
    #       candidate temporary package directory will be checked to see
    #       if it contains this file; otherwise, it will not be added to
    #       the auto-path.
    #
    set packageIndexFileNameOnly [getPackageIndexFileName $language]

    #
    # HACK: Obtain the list of candidate temporary package directories
    #       that may need to be added to the auto-path.  The prefix we
    #       use here is considered "well-known" by this package.
    #
    set directories(1) [lsort [glob -nocomplain -types {d} \
        [file join $temporaryRootDirectory pkgd_lib_*]]]

    foreach directory(1) $directories(1) {
      set directories(2) [lsort [glob -nocomplain -types {d} \
          [file join $directory(1) *]]]

      foreach directory(2) $directories(2) {
        set directoryNameOnly(2) [file tail $directory(2)]
        set packageName $directoryNameOnly(2); # HACK: Well-known.

        if {[lsearch -exact $packageNames $packageName] == -1} then {
          if {[string length $pattern] == 0 || \
              [string match $pattern $directoryNameOnly(2)]} then {
            if {[string length $packageIndexFileNameOnly] == 0 || \
                [file exists [file join $directory(2) \
                    $packageIndexFileNameOnly]]} then {
              if {[maybeAddToAutoPath $language $directory(2)]} then {
                lappend packageNames $directoryNameOnly(2)
                lappend result $directory(2)

                if {$verboseTemporaryDirectory} then {
                  pkgLog [appendArgs \
                      "added temporary package directory named \"" \
                      $directory(2) "\" to auto-path..."]
                }
              }
            }
          }
        }
      }
    }

    return $result
  }

  #
  # NOTE: This package requires the package repository client package.
  #
  package require Eagle.Package.Repository

  #
  # NOTE: This package requires that support for namespaces, which is an
  #       optional feature of Eagle, must be enabled.
  #
  if {[isEagle] && ![namespace enable]} then {
    error "namespaces must be enabled for this package"
  }

  #
  # NOTE: Attempt to read optional settings file now.  This may override
  #       one or more of the variable setup in the next step.
  #
  ::PackageRepository::maybeReadSettingsFiles [info script]

  #
  # NOTE: Setup the variables, within this namespace, used by this script.
  #
  setupDownloadVars [info script] false

  #
  # NOTE: Setup the server, version, and URI variables, in this namespace,
  #       that are used by this script.
  #
  setupDownloadServerVars false
  setupDownloadVersionVars false
  setupDownloadUriVars false

  #
  # NOTE: If necessary, add the package persistence root directory to the
  #       auto-path for the current language.  This will only be done if
  #       it falls outside of the existing auto-path.
  #
  variable persistentRootDirectory

  maybeAddToAutoPath [expr {[isEagle] ? "eagle" : "tcl"}] \
      $persistentRootDirectory

  #
  # NOTE: Provide the package to the interpreter.
  #
  package provide Eagle.Package.Downloader 1.0.11
}
